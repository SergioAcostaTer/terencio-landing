---
import "@fontsource/outfit"; // Defaults to weight 400
import "@fontsource/outfit/600.css";
import "@fontsource/outfit/700.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { ViewTransitions } from "astro:transitions";
import CookieBanner from "../components/CookieBanner.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import SEO from '../components/SEO.astro';
import siteData from "../data/siteData.json";

interface Props {
  title: string;
  description?: string;
  image?: string; // For backwards compatibility
  ogImage?: string; // Specific OG image for social sharing
  preloadImage?: string; // NEW: Critical for LCP Score
  canonical?: string;
  type?: "website" | "article";
  publishDate?: string;
  author?: string;
  noindex?: boolean;
}

const { 
  title, 
  description = siteData.shortDescription, 
  image, 
  ogImage, 
  preloadImage,
  canonical = Astro.url.href,
  type = "website",
  publishDate,
  author,
  noindex = false
} = Astro.props;

// Use ogImage if provided, fallback to image, then default
// const socialImage = ogImage || image || "/og-image.jpg";

// Breadcrumbs Schema
const breadcrumbsSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": siteData.url
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": title,
      "item": canonical
    }
  ]
};

---

<!doctype html>
<html lang="es" class="scroll-smooth overflow-x-hidden">
  <head>
    <SEO 
      title={title} 
      description={description} 
      ogImage={ogImage}
      canonical={canonical}
      type={type}
      publishDate={publishDate}
      author={author}
      noindex={noindex}
    />

    <!-- CRITICAL LCP OPTIMIZATION: Preload Hero Image if provided -->
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}

    <!-- LocalBusiness Schema (JSON-LD) -->
    <LocalBusinessSchema />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsSchema)} />

    <!-- Resource Hints for Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- OPTIMIZED FONT LOADING: Non-blocking Material Icons -->
    <link 
      href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" 
      rel="stylesheet" 
      media="print" 
      onload="this.media='all'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet">
    </noscript>

    <ViewTransitions />
  </head>
  <body class="min-h-screen flex flex-col font-sans text-gray-800 bg-gray-50 overflow-x-hidden">
    <SpeedInsights />
    <Analytics />
    <Header />
    <main class="flex-grow pt-[120px]">
      <slot />
    </main>
    <Footer />
    
    <div class="md:hidden fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.1)] z-[60] flex justify-between px-3 py-3 gap-3 pb-[calc(12px+env(safe-area-inset-bottom))]">
  
      <a href="tel:922550067" class="flex-1 flex flex-col items-center justify-center bg-gray-50 border border-gray-200 rounded-lg p-1 text-gray-800 active:bg-gray-200 transition">
        <span class="material-icons-outlined text-green-700 text-2xl">call</span>
        <span class="text-[10px] font-bold uppercase mt-1">Llamar</span>
      </a>
    
      <a href="mailto:info@kitcash.es" class="flex-1 flex flex-col items-center justify-center bg-gray-50 border border-gray-200 rounded-lg p-1 text-gray-800 active:bg-gray-200 transition">
        <span class="material-icons-outlined text-green-600 text-2xl">mail</span>
        <span class="text-[10px] font-bold uppercase mt-1">Email</span>
      </a>
    
      <a href="https://www.google.com/maps/search/?api=1&query=Terencio+Cash+Market" target="_blank" class="flex-[1.5] flex items-center justify-center gap-2 bg-green-700 text-white rounded-lg p-2 shadow-md active:bg-green-800 transition">
        <span class="material-icons-outlined">near_me</span>
        <span class="text-xs font-bold uppercase">Ir Ahora</span>
      </a>
    
    </div>
    
    <CookieBanner />
  </body>
</html>

<style is:global>
  /* Base styles */
  :root {
    --color-primary: 22, 101, 52; /* green-800 */
    --color-accent: 220, 38, 38; /* red-600 */
  }
  
  html {
    font-family: 'Outfit', sans-serif;
    font-display: swap;
  }
  
  body { 
    padding-bottom: calc(85px + env(safe-area-inset-bottom)); 
  }
  @media (min-width: 768px) {
    body { padding-bottom: 0; }
  }
</style>