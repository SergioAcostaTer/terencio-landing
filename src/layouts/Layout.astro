---
import "@fontsource/outfit"; // Defaults to weight 400
import "@fontsource/outfit/600.css";
import "@fontsource/outfit/700.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { ViewTransitions } from "astro:transitions";
import CookieBanner from "../components/CookieBanner.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import siteData from "../data/siteData.json";

interface Props {
  title: string;
  description?: string;
  image?: string; // For backwards compatibility, will be used as ogImage if ogImage not provided
  ogImage?: string; // Specific OG image for social sharing
  canonical?: string;
  type?: "website" | "article";
  publishDate?: string;
  author?: string;
}

const { 
  title, 
  description = siteData.shortDescription, 
  image, // Keep for backwards compatibility
  ogImage, // New dedicated OG image prop
  canonical = Astro.url.href,
  type = "website",
  publishDate,
  author
} = Astro.props;

// Use ogImage if provided, fallback to image, then default
const socialImage = ogImage || image || "/og-image.jpg";

// Breadcrumbs Schema
const breadcrumbsSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": siteData.url
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": title,
      "item": canonical
    }
  ]
};

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": siteData.name,
  "legalName": siteData.legalName,
  "image": [
    `${siteData.url}/logo.png`,
    `${siteData.url}/store-front.jpg`
  ],
  "@id": siteData.url,
  "url": siteData.url,
  "telephone": siteData.contact.phone,
  "email": siteData.contact.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteData.address.streetAddress,
    "addressLocality": siteData.address.addressLocality,
    "addressRegion": siteData.address.addressRegion,
    "postalCode": siteData.address.postalCode,
    "addressCountry": siteData.address.addressCountry
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": siteData.geo.latitude,
    "longitude": siteData.geo.longitude
  },
  "openingHoursSpecification": siteData.hours.map(h => ({
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": h.dayOfWeek,
    "opens": h.opens,
    "closes": h.closes
  })),
  "priceRange": "€",
  "department": [
    {
      "@type": "ButcherShop",
      "name": "Carnicería Terencio",
      "image": `${siteData.url}/assets/images/supermercado-interior.jpg`,
      "telephone": siteData.contact.phone,
      "openingHoursSpecification": siteData.hours.map(h => ({
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": h.dayOfWeek,
        "opens": h.opens,
        "closes": h.closes
      }))
    },
    {
       "@type": "WholesaleStore",
       "name": "Terencio Cash & Carry",
       "image": `${siteData.url}/store-local.jpg`,
       "telephone": siteData.contact.phone,
       "openingHoursSpecification": siteData.hours.map(h => ({
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": h.dayOfWeek,
        "opens": h.opens,
        "closes": h.closes
      }))
    }
  ]
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- SEO Meta Tags -->
    <title>{title} | {siteData.name}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteData.name} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(socialImage, Astro.url)} />
    <meta property="og:site_name" content={siteData.name} />
    <meta property="og:locale" content="es_ES" />
    {type === 'article' && (
      <>
        {publishDate && <meta property="article:published_time" content={publishDate} />}
        {author && <meta property="article:author" content={author} />}
      </>
    )}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(socialImage, Astro.url)} />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#166534" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsSchema)} />

    <!-- Google Fonts Removed (Using self-hosted @fontsource/outfit) -->

    <!-- Resource Hints for Performance -->
    <link rel="dns-prefetch" href="https://maps.google.com" />
    <link rel="dns-prefetch" href="https://maps.googleapis.com" />

    <ViewTransitions />
  </head>
  <body class="min-h-screen flex flex-col font-sans text-gray-800 bg-gray-50">
    <SpeedInsights />
    <Analytics />
    <Header />
    <main class="flex-grow pt-20">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>

<style is:global>
  /* Base styles */
  :root {
    --color-primary: 22, 101, 52; /* green-800 */
    --color-accent: 220, 38, 38; /* red-600 */
  }
  
  html {
    font-family: 'Outfit', sans-serif;
  }
</style>
