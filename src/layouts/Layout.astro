---
import "@fontsource/outfit"; // Defaults to weight 400
import "@fontsource/outfit/600.css";
import "@fontsource/outfit/700.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { ViewTransitions } from "astro:transitions";
import CookieBanner from "../components/CookieBanner.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import SEO from '../components/SEO.astro';
import siteData from "../data/siteData.json";

interface Props {
  title: string;
  description?: string;
  image?: string; // For backwards compatibility, will be used as ogImage if ogImage not provided
  ogImage?: string; // Specific OG image for social sharing
  canonical?: string;
  type?: "website" | "article";
  publishDate?: string;
  author?: string;
  noindex?: boolean;
}

const { 
  title, 
  description = siteData.shortDescription, 
  image, // Keep for backwards compatibility
  ogImage, // New dedicated OG image prop
  canonical = Astro.url.href,
  type = "website",
  publishDate,
  author,
  noindex = false
} = Astro.props;

// Use ogImage if provided, fallback to image, then default
const socialImage = ogImage || image || "/og-image.jpg";

// Breadcrumbs Schema
const breadcrumbsSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": siteData.url
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": title,
      "item": canonical
    }
  ]
};

---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <SEO 
      title={title}
      description={description}
      ogImage={ogImage}
      canonical={canonical}
      type={type}
      publishDate={publishDate}
      author={author}
      noindex={noindex}
    />

    <!-- LocalBusiness Schema (JSON-LD) -->
    <LocalBusinessSchema />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsSchema)} />

    <!-- Google Fonts Removed (Using self-hosted @fontsource/outfit) -->

    <!-- Resource Hints for Performance -->
    <link rel="dns-prefetch" href="https://maps.google.com" />
    <link rel="dns-prefetch" href="https://maps.googleapis.com" />

    <ViewTransitions />
  </head>
  <body class="min-h-screen flex flex-col font-sans text-gray-800 bg-gray-50">
    <SpeedInsights />
    <Analytics />
    <Header />
    <main class="flex-grow pt-20">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>

<style is:global>
  /* Base styles */
  :root {
    --color-primary: 22, 101, 52; /* green-800 */
    --color-accent: 220, 38, 38; /* red-600 */
  }
  
  html {
    font-family: 'Outfit', sans-serif;
    font-display: swap;
  }
</style>
