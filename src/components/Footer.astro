---
import { Image } from "astro:assets";
import europa from "../assets/europa.png";
import sub2 from "../assets/fondo-europeo-regional.png";
import logo from "../assets/logo.png";
import sub4 from "../assets/next-generation-eu.png";
import sub3 from "../assets/plan-recuperacion-espana.png";
import sub1 from "../assets/subvencion-gobierno-canarias.png";
import navigation from "../data/navigation.json";
import siteData from "../data/siteData.json";
const year = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-300 py-12 border-t-4 border-green-700">
  <div class="container mx-auto px-4 lg:px-6">
    
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      
      <!-- Brand & Address -->
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-2 mb-2">
             <Image src={logo} alt="Terencio Logo Footer" width={40} height={40} class="h-10 w-auto bg-white p-1 rounded" loading="lazy" />
             <span class="text-white text-xl font-bold tracking-tight">Terencio Cash Market</span>
        </div>
        <address class="not-italic text-sm text-gray-300 space-y-2">
          <p class="flex items-start gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-500 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            <span>{siteData.address.streetAddress}<br>{siteData.address.postalCode} {siteData.address.addressLocality}, {siteData.address.addressRegion}</span>
          </p>
          <a href="https://www.google.com/maps/search/?api=1&query=Terencio+Cash+Market" target="_blank" class="inline-flex items-center gap-2 text-green-400 hover:text-green-300 font-bold transition-colors">
            <span class="material-icons-outlined text-sm">map</span> Ver en Google Maps
          </a>
          <p class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            <a href={`tel:${siteData.contact.phone.replace(/\s/g, "")}`} class="hover:text-white transition-colors">{siteData.contact.phone}</a>
          </p>
          <p class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            <a href={`mailto:${siteData.contact.email}`} class="hover:text-white transition-colors">{siteData.contact.email}</a>
          </p>
        </address>
      </div>

      <!-- Quick Links -->
      <div class="flex flex-col gap-4">
        <h3 class="text-white text-lg font-bold border-b border-gray-700 pb-2 w-fit">Enlaces Rápidos</h3>
        <ul class="space-y-2 text-sm">
          {navigation.footer.quickLinks.map(link => (
            <li><a href={link.href} class="hover:text-green-400 transition-colors text-gray-400 hover:text-green-400">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Schedule -->
      <div class="flex flex-col gap-4">
        <h3 class="text-white text-lg font-bold border-b border-gray-700 pb-2 w-fit">Horario de Apertura</h3>
        <ul class="space-y-2 text-sm">
          <li class="flex flex-col gap-1">
            <span class="text-gray-300 font-medium">{siteData.hoursText}</span>
          </li>
        </ul>
      </div>

     {/* Destacados Column */}
     <div class="flex flex-col gap-4">
        <h3 class="text-white text-lg font-bold border-b border-gray-700 pb-2 w-fit">Destacados</h3>
        <ul class="space-y-2 text-sm">
          {navigation.footer.featured.map(link => (
            <li><a href={link.href} class="hover:text-green-400 transition-colors text-gray-400">{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Logos Subvenciones (Bottom Placement) -->
    <section class="flex flex-col items-center justify-center gap-6 mt-12 pt-8 border-t border-gray-800">
       <div class="flex flex-wrap justify-center gap-4">
          <Image src={sub1} alt="Subvención 1" width={100} height={64} class="h-12 md:h-16 w-auto grayscale hover:grayscale-0 transition opacity-80 hover:opacity-100" loading="lazy" />
          <Image src={sub2} alt="Subvención 2" width={200} height={64} class="h-12 md:h-16 w-auto grayscale hover:grayscale-0 transition opacity-80 hover:opacity-100" loading="lazy" />
          <Image src={sub3} alt="Subvención 3" width={100} height={64} class="h-12 md:h-16 w-auto grayscale hover:grayscale-0 transition opacity-80 hover:opacity-100" loading="lazy" />
          <Image src={sub4} alt="Subvención 4" width={200} height={64} class="h-12 md:h-16 w-auto grayscale hover:grayscale-0 transition opacity-80 hover:opacity-100" loading="lazy" />
       </div>
       <div class="w-full md:w-auto flex justify-center mt-4 md:mt-0">
          <Image src={europa} alt="Logo Europa" width={580} height={180} class="w-full max-w-[580px] md:w-auto md:h-20 grayscale hover:grayscale-0 transition opacity-80 hover:opacity-100" loading="lazy" />
       </div>
    </section>

    <div class="border-t border-gray-800 mt-8 pt-6 flex flex-col md:flex-row justify-between items-center text-xs text-gray-500">
      <p>&copy; {year} {siteData.legalName} Todos los derechos reservados.</p>
      <div class="flex flex-col md:flex-row gap-4 mt-4 md:mt-0 items-center">
         <!-- Payment / Trust Icons -->
         <div class="flex items-center gap-3 bg-white/10 p-2 rounded-lg backdrop-blur-sm">
            <!-- Visa -->
            <svg class="h-6 w-auto" viewBox="0 0 48 32" fill="none" xmlns="http://www.w3.org/2000/svg">
               <path d="M18.534 0.999985H24.379L20.73 23.361H14.885L18.534 0.999985Z" fill="#fff"/>
               <path d="M12.28 0.999985C10.669 0.999985 10.395 0.999985 8.79001 0.999985C8.42801 0.999985 7.66901 0.999985 7.64301 1.09698L2.61001 22.864C2.56901 23.076 2.76801 23.361 3.01001 23.361H8.05801C8.61801 23.361 9.10201 22.992 9.22701 22.45L9.61301 20.373L12.564 20.373C12.923 20.373 13.251 20.655 13.315 21.011L13.725 23.361H18.895L15.908 6.01499C15.428 3.10999 14.545 0.999985 12.28 0.999985ZM12.721 16.485H10.339L11.535 9.77098C11.535 9.77098 11.961 16.485 12.721 16.485Z" fill="#fff"/>
               <path d="M29.13 23.361H34.469C34.469 23.361 35.342 16.425 35.483 15.602C35.295 15.688 34.819 15.795 34.204 15.795C32.149 15.795 30.736 14.654 30.736 12.392V12.355C30.736 10.224 32.559 7.84499 35.597 7.84499C36.636 7.84499 37.387 8.05399 37.79 8.23299L38.461 4.39899C37.893 4.13399 36.638 3.86899 35.155 3.86899C30.957 3.86899 26.68 6.07998 26.68 11.597V11.637C26.68 12.067 26.708 13.719 28.324 16.59L27.152 23.361H29.13ZM44.757 23.361L48 6.55699C47.386 6.30799 45.918 6.03698 44.09 6.03698C40.672 6.03698 39.855 8.65399 39.73 9.47199L35.267 23.361H40.595L40.941 21.365C40.941 21.365 42.493 21.2 43.141 20.317C43.832 19.387 44.17 18.067 44.17 18.067L44.757 23.361Z" fill="#fff"/>
               <path d="M7.749 0.999985H0.106003L0 1.25298C5.004 2.45098 8.019 6.94498 9.389 9.87298L7.749 0.999985Z" fill="#fff"/>
            </svg>
            <!-- Mastercard -->
            <svg class="h-6 w-auto" viewBox="0 0 50 32" fill="none" xmlns="http://www.w3.org/2000/svg">
               <rect width="50" height="32" rx="2" fill="#222"/>
               <circle cx="17" cy="16" r="10" fill="#EB001B"/>
               <circle cx="33" cy="16" r="10" fill="#F79E1B"/>
               <path d="M25 21C27.7614 21 30 18.7614 30 16C30 13.2386 27.7614 11 25 11C22.2386 11 20 13.2386 20 16C20 18.7614 22.2386 21 25 21Z" fill="#FF5F00"/>
            </svg>
            <!-- Bizum text fallback/simple badge -->
            <div class="h-6 px-1 bg-blue-100 flex items-center rounded">
               <span class="text-blue-600 font-bold text-xs tracking-tighter">bizum</span>
            </div>
         </div>
         
         <div class="flex gap-4">
             <a href="/aviso-legal" class="hover:text-white transition-colors">Aviso Legal</a>
             <a href="/politica-privacidad" class="hover:text-white transition-colors">Política de Privacidad</a>
             <a href="/cookies" class="hover:text-white transition-colors">Cookies</a>
         </div>
      </div>
    </div>
  </div>
</footer>