<footer
  class="footer bg-[#196F3D] text-white py-6 w-full flex items-center justify-center flex-col"
>
  <section
    class="flex items-center justify-center gap-4 mb-6 md:h-24 flex-col md:flex-row px-4 md:px-0"
  >
    <img src="/sub/1.png" alt="Logo 1" class="w-auto h-28 md:h-full" />
    <img src="/sub/2.png" alt="Logo 2" class="w-auto h-28 md:h-full" />
    <img src="/sub/3.png" alt="Logo 3" class="w-auto h-28 md:h-full" />
    <img src="/sub/4.png" alt="Logo 4" class="w-auto h-28 md:h-full" />
  </section>

  <img src="/europa.png" alt="Logo Europa" class="w-auto min-h-32 mb-6" />

  <div
    class="container mx-auto flex flex-col items-center justify-between gap-2"
  >
    <div class="mb-4 md:mb-0 flex items-center gap-8">
      <a href="tel:922550067" class="block text-lg font-bold hover:underline">
        <span>922 55 00 67</span>
      </a>
      <a href="mailto:info@kitcash.es" class="block text-md hover:underline">
        <span>info@kitcash.es</span>
      </a>
    </div>

    <a
      href="./sources/PoliticaDePrivacidad.pdf"
      target="_blank"
      class="text-sm mb-4 md:mb-0 hover:underline"
    >
      Políticas de privacidad
    </a>

    <div class="text-center">
      <p class="text-xs" id="copyright-year">
        © Terencio Supermercados <span id="year"></span>
      </p>
      <p class="text-xs">B38723458. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<script>
  document.getElementById("year").textContent = new Date()
    .getFullYear()
    .toString();
</script>
