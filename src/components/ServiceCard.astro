---
interface Props {
  title: string;
  description: string;
  icon: string; // Material Icon name or similar
  link?: string;
}

const { title, description, icon, link } = Astro.props;
---

<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow group">
  <div class="w-12 h-12 bg-green-50 rounded-lg flex items-center justify-center text-green-700 mb-4 group-hover:bg-green-600 group-hover:text-white transition-colors">
    <!-- Using a simple mapping for icons or verifying if we use an icon library. 
         For now, simplified SVG placeholders based on name or generic. -->
    <span class="font-bold text-xl select-none material-icons-outlined">
     {icon === 'store' && '🏪'}
     {icon === 'shopping-cart' && '🛒'}
     {icon === 'utensils' && '🍽️'}
     {icon === 'parking' && '🅿️'}
     {!['store', 'shopping-cart', 'utensils', 'parking'].includes(icon) && '✨'}
    </span>
  </div>
  <h3 class="text-xl font-bold text-gray-900 mb-2">{title}</h3>
  <p class="text-gray-600 mb-4 leading-relaxed">{description}</p>
  {link && (
    <a href={link} class="text-green-700 font-semibold hover:text-green-800 inline-flex items-center gap-1 group-hover:underline">
      Saber más <span>&rarr;</span>
    </a>
  )}
</div>
