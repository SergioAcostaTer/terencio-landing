---
import siteData from "../data/siteData.json";
import navigation from "../data/navigation.json";
import StoreStatus from "./StoreStatus.astro";
import Icon from "./ui/Icon";
import { Image } from "astro:assets";
import logo from "../assets/images/logo.webp";
---

<header class="fixed top-0 w-full z-50 bg-white shadow-lg transition-all duration-300 flex flex-col" id="main-header">
  <div class="h-[80px] container mx-auto px-4 lg:px-6 flex items-center justify-between flex-shrink-0">
    
    <!-- Mobile Left: Phone Icon (Visible only on mobile) -->
    <a href={`tel:${siteData.contact.phone.replace(/\s/g, "")}`} class="md:hidden flex items-center justify-center w-10 h-10 text-green-700 hover:bg-green-50 rounded-full transition" aria-label="Llamar">
      <span class="material-icons-outlined text-2xl">phone</span>
    </a>

    <!-- Brand / Logo (Centered on mobile, Left on desktop) -->
    <a href="/" class="flex items-center gap-2 h-14 md:h-12 absolute left-1/2 transform -translate-x-1/2 md:static md:transform-none md:mr-auto" aria-label="Ir a inicio">
      <Image class="h-full w-auto object-contain" src={logo} alt="Logotipo Terencio" width={56} height={56} loading="eager" />
      <span class="sr-only">Terencio Cash Market</span>
    </a>

    <!-- Desktop Menu -->
    <nav class="hidden md:flex items-center gap-2 lg:gap-1">
      {navigation.main.map(link => (
        <div class="relative group">
          <a 
            href={link.href} 
            class:list={[
              "text-sm lg:text-base font-semibold transition-all flex items-center gap-1 px-3 py-2 rounded-lg",
              (link as any).color === 'red' ? "text-red-600 hover:bg-red-50 hover:text-red-700 font-bold" : "text-gray-700 hover:bg-green-50 hover:text-green-700"
            ]}
          >
            {link.label}
            {link.children && <Icon name="ChevronDown" size={16} className="mt-0.5 group-hover:rotate-180 transition-transform" />}
          </a>
          
          {/* Dropdown Menu */}
          {link.children && (
            <div class="absolute top-full left-0 pt-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform group-hover:translate-y-0 translate-y-2 z-50">
               <div class="bg-white shadow-xl rounded-xl border-t-4 border-green-600 border-x border-b border-gray-100 py-3 w-60 overflow-hidden">
                  {link.children.map(child => (
                    <a href={child.href} class="block px-6 py-2.5 text-gray-700 hover:bg-green-50 hover:text-green-800 text-[15px] font-medium transition-colors">
                      {child.label}
                    </a>
                  ))}
               </div>
            </div>
          )}
        </div>
      ))}
      <a 
        href="https://www.google.com/maps/search/?api=1&query=Terencio+Cash+Market"
        target="_blank"
        class="hidden lg:flex bg-white border border-green-700 text-green-700 px-4 py-2 rounded-lg font-bold hover:bg-green-50 transition-colors shadow-sm ml-4 items-center gap-2"
      >
        <span class="material-icons-outlined">navigation</span> Cómo llegar
      </a>
      <a 
        href={navigation.cta.href} 
        class="bg-green-700 text-white px-5 py-2 rounded-lg font-bold hover:bg-green-800 transition-colors shadow-md hover:shadow-lg text-sm lg:text-base ml-2"
      >
        {navigation.cta.label}
      </a>
    </nav>

    <!-- Mobile Right: Hamburger Button -->
    <button id="menu-toggle" class="md:hidden flex items-center justify-center w-10 h-10 rounded-lg hover:bg-gray-100 text-gray-800 focus:outline-none" aria-label="Menú">
      <span class="material-icons-outlined text-3xl" id="menu-icon">menu</span>
    </button>
  </div>

  <!-- Subheader Status Bar -->
  <StoreStatus />

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="fixed top-[80px] left-0 w-full h-[calc(100dvh-80px)] bg-white z-[70] transform translate-x-full transition-transform duration-300 md:hidden overflow-y-auto pb-24">
    <div class="flex flex-col p-6 gap-6">
      {navigation.main.map((link, index) => (
        <div class="group">
          <div class="flex items-center justify-between">
            <a 
              href={link.href} 
              class:list={[
                "text-xl mobile-link pb-2 block flex-grow",
                (link as any).color === 'red' ? "font-bold text-red-600" : "font-semibold text-gray-800"
              ]}
            >
              {link.label}
            </a>
            {link.children && (
              <button 
                class="p-2 text-gray-500 hover:bg-gray-100 rounded-full transition-colors focus:outline-none submenu-toggle" 
                aria-label={`Toggle submenu for ${link.label}`}
                data-index={index}
              >
                <span class="material-icons-outlined transition-transform duration-300">expand_more</span>
              </button>
            )}
          </div>
          
          {/* Mobile Submenu (Accordion) */}
          {link.children && (
            <div 
              id={`submenu-${index}`}
              class="hidden pl-4 border-l-2 border-gray-100 mt-2 flex flex-col gap-3 transition-all duration-300"
            >
              {link.children.map(child => (
                  <a href={child.href} class="text-base text-gray-600 mobile-link block py-1">
                    {child.label}
                  </a>
              ))}
            </div>
          )}
          <div class="border-b border-gray-100 mt-2"></div>
        </div>
      ))}
      
      {navigation.mobileExtra.map(link => (
        <a href={link.href} class="text-xl font-semibold text-gray-800 mobile-link border-b border-gray-100 pb-2">
          {link.label}
        </a>
      ))}

      <a href={navigation.cta.href} class="text-xl font-bold text-white bg-green-700 px-4 py-3 rounded-lg text-center mt-4 mobile-link">
        {navigation.cta.label}
      </a>
      
      <a href="https://www.google.com/maps/search/?api=1&query=Terencio+Cash+Market" target="_blank" class="text-xl font-bold text-green-700 border-2 border-green-700 px-4 py-3 rounded-lg text-center mt-2 mobile-link flex items-center justify-center gap-2">
        <span class="material-icons-outlined">navigation</span> Cómo llegar
      </a>
      
      <div class="mt-8 text-center text-gray-500 text-sm">
          <p class="mb-2">Llámanos</p>
          <a href={`tel:${siteData.contact.phone.replace(/\s/g, "")}`} class="text-2xl font-bold text-green-700">{siteData.contact.phone}</a>
      </div>
    </div>
  </div>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');

    if (menuToggle && mobileMenu && menuIcon) {
      // Remove any existing listeners to avoid duplication
      const toggleMenu = () => {
        const isClosed = mobileMenu.classList.contains('translate-x-full');
        
        if (isClosed) {
          // Open
          mobileMenu.classList.remove('translate-x-full');
          menuIcon.textContent = 'close';
          document.body.style.overflow = 'hidden'; 
        } else {
          // Close
          mobileMenu.classList.add('translate-x-full');
          menuIcon.textContent = 'menu';
          document.body.style.overflow = '';
        }
      };

      menuToggle.addEventListener('click', toggleMenu);

      document.querySelectorAll('.mobile-link').forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('translate-x-full');
          menuIcon.textContent = 'menu';
          document.body.style.overflow = '';
        });
      });

      // Accordion Logic
      document.querySelectorAll('.submenu-toggle').forEach(button => {
        button.addEventListener('click', (e) => {
          e.stopPropagation();
          const index = button.getAttribute('data-index');
          const submenu = document.getElementById(`submenu-${index}`);
          const arrow = button.querySelector('span');

          if (submenu) {
             const isHidden = submenu.classList.contains('hidden');
             if (isHidden) {
               submenu.classList.remove('hidden');
               if(arrow) arrow.style.transform = 'rotate(180deg)';
             } else {
               submenu.classList.add('hidden');
               if(arrow) arrow.style.transform = 'rotate(0deg)';
             }
          }
        });
      });
    }
  });
</script>