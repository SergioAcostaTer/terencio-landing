---
import siteData from "../data/siteData.json";
import navigation from "../data/navigation.json";
import StoreStatus from "./StoreStatus.astro";
import Icon from "./ui/Icon";
import { Image } from "astro:assets";
import logo from "../assets/images/logo.webp";
---

<header class="fixed top-0 w-full z-50 bg-white shadow-md transition-all duration-300 flex flex-col font-sans" id="main-header">
  
  <!-- Barra Superior (Desktop) - Información crítica -->
  <div class="hidden md:flex bg-brand-primary text-white text-xs py-2 justify-between px-6 lg:px-8 border-b border-green-800">
    <div class="flex gap-6">
       <a href="https://g.page/r/CWkyvLywov7bEBM/review" target="_blank" class="flex items-center gap-1 font-medium hover:text-yellow-200 transition">
          <Icon name="MapPin" size={14}/> Ctra. La Esperanza 22, La Laguna
       </a>
       <span class="flex items-center gap-1 font-bold text-yellow-300 animate-pulse">
          <Icon name="Calendar" size={14}/> ¡ABIERTO DOMINGOS!
       </span>
    </div>
    <div class="flex gap-6">
       <a href="/profesionales" class="hover:text-yellow-200 transition font-medium">Zona Profesionales HORECA</a>
       <a href={`tel:${siteData.contact.phoneRaw}`} class="flex items-center gap-1 font-bold hover:text-yellow-200 transition">
          <Icon name="Phone" size={14}/> {siteData.contact.phone}
       </a>
    </div>
  </div>

  <div class="h-[70px] md:h-[80px] container mx-auto px-4 lg:px-6 flex items-center justify-between flex-shrink-0 bg-white relative z-50">
    
    <!-- Mobile Left: Hamburger -->
    <button id="menu-toggle" class="md:hidden flex items-center justify-center w-12 h-12 rounded-xl text-gray-800 focus:outline-none hover:bg-gray-100 transition" aria-label="Menú Principal">
      <span class="material-icons-outlined text-3xl" id="menu-icon">menu</span>
    </button>

    <!-- Brand / Logo -->
    <a href="/" class="flex items-center gap-3 relative group" aria-label="Terencio Cash Market Inicio">
      <div class="h-8 md:h-12 flex items-center">
        <Image class="h-full w-auto object-contain transition-transform group-hover:scale-105" src={logo} alt="Logotipo Terencio Supermercado" width={48} height={48} loading="eager" />
      </div>
      <div class="hidden sm:flex flex-col leading-tight justify-center gap-0.5">
        <span class="text-lg lg:text-xl font-bold text-brand-dark tracking-tight leading-none">Terencio</span>
        <span class="text-[10px] lg:text-xs text-brand-primary font-bold uppercase tracking-widest leading-none">Cash Market</span>
      </div>
    </a>

    <!-- Desktop Menu -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2">
      {navigation.main.map(link => (
        <div class="relative group">
          <a 
            href={link.href} 
            class:list={[
              "text-sm lg:text-[15px] font-bold transition-all flex items-center gap-1 px-3 py-2 rounded-lg",
              (link as any).color === 'red' ? "text-red-600 bg-red-50 hover:bg-red-100" : "text-gray-700 hover:text-brand-primary hover:bg-gray-50"
            ]}
          >
            {link.label}
            {link.children && <Icon name="ChevronDown" size={14} className="mt-0.5 group-hover:rotate-180 transition-transform text-gray-400" />}
          </a>
          
          {/* Dropdown Menu */}
          {link.children && (
            <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform group-hover:translate-y-0 translate-y-2 z-50">
               <div class="bg-white shadow-xl rounded-xl border border-gray-100 p-2 w-64 overflow-hidden ring-1 ring-black ring-opacity-5">
                  {link.children.map(child => (
                    <a href={child.href} class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-green-50 hover:text-green-800 rounded-lg text-sm font-medium transition-colors group/item">
                      <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-gray-500 group-hover/item:bg-green-200 group-hover/item:text-green-700 transition">
                         {child.label.includes('Carnicería') ? <span class="text-base">🥩</span> :
                          child.label.includes('Quesos') ? <span class="text-base">🧀</span> :
                          child.label.includes('Hierro') ? <span class="text-base">🍍</span> :
                          child.label.includes('Cash') ? <span class="text-base">🛒</span> :
                          <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>}
                      </div>
                      <div class="flex flex-col">
                          <span class="leading-none">{child.label}</span>
                      </div>
                    </a>
                  ))}
               </div>
            </div>
          )}
        </div>
      ))}
      
      <a 
        href={navigation.cta.href} 
        class="ml-4 bg-brand-primary text-white px-6 py-2.5 rounded-xl font-bold hover:bg-green-800 transition-all shadow-md hover:shadow-lg text-sm flex items-center gap-2 transform hover:-translate-y-0.5"
      >
        {navigation.cta.label}
        <Icon name="ArrowRight" size={16} />
      </a>
    </nav>

    <!-- Mobile Right: Ofertas Icon -->
    <a href="/ofertas" class="md:hidden flex items-center justify-center w-12 h-12 text-red-600 bg-red-50 rounded-xl active:scale-95 transition" aria-label="Ver Ofertas">
      <span class="material-icons-outlined text-2xl animate-pulse">local_offer</span>
    </a>
  </div>

  <StoreStatus />

  <!-- Mobile Menu Overlay -->
  <div id="mobile-menu" class="fixed top-[105px] left-0 w-full h-[calc(100dvh-105px)] bg-white z-[70] transform translate-x-full transition-transform duration-300 md:hidden overflow-y-auto pb-32 shadow-inner">
    <div class="flex flex-col p-6 gap-2">
      {navigation.main.map((link, index) => (
        <div class="border-b border-gray-50 last:border-0 pb-2">
          <div class="flex items-center justify-between">
            <a 
              href={link.href} 
              class:list={[
                "text-lg font-bold py-3 block flex-grow mobile-link",
                (link as any).color === 'red' ? "text-red-600" : "text-gray-800"
              ]}
            >
              {link.label}
            </a>
            {link.children && (
              <button 
                class="p-4 text-gray-400 hover:bg-gray-100 rounded-full submenu-toggle focus:outline-none" 
                data-index={index}
                aria-label={`Abrir submenú de ${link.label}`}
              >
                <span class="material-icons-outlined text-xl transition-transform">expand_more</span>
              </button>
            )}
          </div>
          
          {link.children && (
            <div id={`submenu-${index}`} class="hidden pl-4 bg-gray-50 rounded-xl mt-1 mb-2 border border-gray-100">
              {link.children.map(child => (
                  <a href={child.href} class="text-base text-gray-600 mobile-link block py-3 px-2 font-medium border-b border-gray-200 last:border-0 hover:text-green-700 flex items-center gap-2">
                    <span class="material-icons-outlined text-sm text-green-600">chevron_right</span>
                    {child.label}
                  </a>
              ))}
            </div>
          )}
        </div>
      ))}
      
      <div class="mt-6 space-y-4">
        <a href="/profesionales" class="flex items-center justify-between w-full p-4 bg-slate-900 text-white rounded-xl font-bold mobile-link shadow-lg">
           <div class="flex items-center gap-3">
              <span class="material-icons-outlined">storefront</span>
              <span>Zona Profesionales</span>
           </div>
           <span class="material-icons-outlined">arrow_forward</span>
        </a>
        <a href="/carniceria-tenerife" class="flex items-center justify-between w-full p-4 bg-red-600 text-white rounded-xl font-bold mobile-link shadow-lg">
           <div class="flex items-center gap-3">
              <span class="material-icons-outlined">restaurant_menu</span>
              <span>Nuestra Carnicería</span>
           </div>
           <span class="material-icons-outlined">arrow_forward</span>
        </a>
      </div>

      <div class="mt-8 pt-6 border-t border-gray-100 text-center text-sm text-gray-500">
          <p class="font-medium mb-2">Síguenos en redes</p>
          <div class="flex justify-center gap-6">
             <a href={siteData.social.facebook} target="_blank" class="text-blue-600 bg-blue-50 p-3 rounded-full hover:bg-blue-100 transition" aria-label="Facebook"><i class="fab fa-facebook text-xl"></i></a>
             <a href={siteData.social.instagram} target="_blank" class="text-pink-600 bg-pink-50 p-3 rounded-full hover:bg-pink-100 transition" aria-label="Instagram"><i class="fab fa-instagram text-xl"></i></a>
          </div>
          <div class="mt-6 text-xs text-gray-400">
            <p>Terencio Cash Market</p>
            <p>La Laguna, Tenerife</p>
          </div>
      </div>
    </div>
  </div>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');

    if (menuToggle && mobileMenu && menuIcon) {
      const toggleMenu = () => {
        const isClosed = mobileMenu.classList.contains('translate-x-full');
        if (isClosed) {
          mobileMenu.classList.remove('translate-x-full');
          menuIcon.textContent = 'close';
          document.body.style.overflow = 'hidden'; 
        } else {
          mobileMenu.classList.add('translate-x-full');
          menuIcon.textContent = 'menu';
          document.body.style.overflow = '';
        }
      };

      menuToggle.addEventListener('click', toggleMenu);

      document.querySelectorAll('.mobile-link').forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('translate-x-full');
          menuIcon.textContent = 'menu';
          document.body.style.overflow = '';
        });
      });

      // Accordion Logic
      document.querySelectorAll('.submenu-toggle').forEach(button => {
        button.addEventListener('click', (e) => {
          e.stopPropagation();
          const index = button.getAttribute('data-index');
          const submenu = document.getElementById(`submenu-${index}`);
          const arrow = button.querySelector('span');

          if (submenu) {
             const isHidden = submenu.classList.contains('hidden');
             if (isHidden) {
               submenu.classList.remove('hidden');
               if(arrow) arrow.style.transform = 'rotate(180deg)';
             } else {
               submenu.classList.add('hidden');
               if(arrow) arrow.style.transform = 'rotate(0deg)';
             }
          }
        });
      });
    }
  });
</script>