---
import elHierroImg from "../assets/images/buceo-el-hierro-experiencia.webp";
import heroBg from "../assets/images/hero-bg.webp";
import carniceriaImg from "../assets/images/supermercado-interior.webp";

import Hero from "../components/Hero.astro";
import LocationSection from "../components/LocationSection.astro";
import LocalBusinessSchema from "../components/SEO/LocalBusinessSchema.astro";
import Icon from "../components/ui/Icon";
import Section from "../components/ui/Section.astro";
import ContentWidget from "../components/widgets/ContentWidget.astro";
import GoogleReviews from "../components/widgets/GoogleReviews.astro";
import Layout from "../layouts/Layout.astro";

// Keywords SEO integradas en título y descripción
const title = "Terencio Cash Market | Supermercado en La Esperanza y Mayorista Tenerife";
const description = "Tu supermercado en La Esperanza abierto los domingos. Cash & Carry sin carnet para particulares y mayorista para HORECA. Carne fresca, Carne de Fiesta y productos de El Hierro.";
---

<LocalBusinessSchema />
<Layout title={title} description={description} image={carniceriaImg.src} preloadImage={heroBg.src}>
  <main>
    <Hero 
      title="Tu Supermercado en <span class='text-green-400'>La Esperanza</span> y Mayorista para <span class='text-yellow-400'>Tenerife</span>"
      subtitle="El único Cash & Carry donde familias y profesionales compran al mejor precio. Carnicería propia, quesadillas de El Hierro y abierto los domingos."
      badge="📍 Ctra. La Esperanza, 22"
      primaryCta={{ text: "Ver Ofertas", href: "/ofertas" }}
      secondaryCta={{ text: "Zona Profesionales", href: "/profesionales" }}
      backgroundImage={heroBg}
    />

    <!-- Quick Info Banner (Sticky visual) -->
    <div class="bg-brand-primary text-white py-4 md:py-6 shadow-lg relative z-20 -mt-2">
      <div class="container mx-auto px-4">
        <div class="flex flex-wrap justify-center md:justify-around gap-y-3 gap-x-6 text-xs md:text-base font-bold uppercase tracking-wider text-center">
          <span class="flex items-center gap-2">
             <span class="material-icons-outlined text-yellow-400">calendar_today</span> Abierto Domingos
          </span>
          <span class="hidden md:inline text-green-400">|</span>
          <span class="flex items-center gap-2">
             <span class="material-icons-outlined text-yellow-400">local_parking</span> Parking Gratis
          </span>
          <span class="hidden md:inline text-green-400">|</span>
          <span class="flex items-center gap-2">
             <span class="material-icons-outlined text-yellow-400">badge</span> Sin Carnet de Socio
          </span>
        </div>
      </div>
    </div>

    <!-- Why We're Different (SEO-rich section) -->
    <Section class="bg-white">
      <div class="max-w-4xl mx-auto text-center mb-12">
        <span class="text-green-700 font-bold uppercase tracking-widest text-sm">Tu Supermercado Diferente</span>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mt-2 mb-6">Por Qué Somos Tu Mejor Opción en Tenerife</h2>
      </div>
      
      <div class="max-w-5xl mx-auto">
        <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed">
          <p class="text-lg md:text-xl mb-6">
            <strong>Terencio Cash Market</strong> es el único <strong>Cash & Carry sin carnet de socio</strong> en Tenerife donde familias y profesionales compran juntos al mejor precio. Ubicados estratégicamente en <strong>La Esperanza</strong>, entre La Laguna y Santa Cruz, ofrecemos una experiencia de compra única con <strong>parking gratuito</strong> propio y amplias instalaciones para que compres con comodidad.
          </p>
          
          <p class="text-base md:text-lg mb-6">
            Nuestra <strong>carnicería propia</strong> cuenta con carniceros profesionales que realizan <strong>despiece diario y corte a cuchillo</strong>—nada de bandejas industriales. Somos especialistas en <strong>Carne de Fiesta</strong>, el corte preferido por guachinches y familias canarias para sus celebraciones. Además, traemos productos exclusivos de <strong>El Hierro</strong> cada semana: quesadillas herreñas artesanales, queso ahumado de Frontera y piña tropical, sabores que no encuentras en cualquier supermercado.
          </p>
          
          <p class="text-base md:text-lg">
            Abrimos <strong>362 días al año</strong>, incluidos domingos y festivos, porque sabemos que las necesidades no entienden de calendario. Con precios mayoristas accesibles sin membresías, formatos grandes que te hacen ahorrar, y una atención cercana de empresa familiar canaria, en Terencio encuentras todo lo que necesitas para tu hogar o tu negocio en un solo lugar.
          </p>
        </div>
      </div>
    </Section>

    <!-- Main Categories Grid (Full Clickable Cards) -->
    <Section class="bg-gray-50">
       <div class="text-center mb-12">
          <span class="text-green-700 font-bold uppercase tracking-widest text-sm">Nuestros Departamentos</span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mt-2 mb-4">¿Qué necesitas hoy?</h2>
          <p class="text-gray-600 max-w-3xl mx-auto text-base md:text-lg leading-relaxed mb-4">
            Calidad, frescura y precios de almacén para todos los públicos. En Terencio encontrarás una amplia variedad de productos: <strong>frescos, congelados, bebidas, limpieza y menaje</strong>, todo en formato mayorista accesible para particulares. Mantenemos <strong>stock permanente</strong> de marcas reconocidas a nivel nacional e internacional, con especial atención a <strong>productos canarios y locales</strong> que apoyan nuestra economía y tradición gastronómica.
          </p>
       </div>

       <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-7xl mx-auto px-2">
          
          <!-- Card Carnicería -->
          <a href="/carniceria-tenerife" class="group relative overflow-hidden rounded-3xl h-80 md:h-96 shadow-md hover:shadow-2xl transition-all duration-500 block">
             <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent z-10"></div>
             <img src={carniceriaImg.src} alt="Carnicería Terencio Tenerife - Carne de Fiesta" class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-110 transition duration-700" loading="lazy"/>
             <div class="absolute bottom-0 left-0 p-6 z-20 text-white w-full">
                <span class="bg-red-600 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block">Corte a Cuchillo</span>
                <h3 class="text-2xl md:text-3xl font-bold mb-2 flex items-center gap-2">Carnicería <Icon name="ArrowRight" size={24} className="opacity-0 group-hover:opacity-100 transition-opacity -translate-x-4 group-hover:translate-x-0 duration-300"/></h3>
                <p class="text-gray-200 text-sm md:text-base opacity-90 leading-relaxed">
                  Despiece propio diario. Especialistas en <strong>Carne de Fiesta</strong>, chuletas y preparados cárnicos para guachinches y familias.
                </p>
             </div>
          </a>

          <!-- Card El Hierro -->
          <a href="/productos-el-hierro-tenerife" class="group relative overflow-hidden rounded-3xl h-80 md:h-96 shadow-md hover:shadow-2xl transition-all duration-500 block">
             <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent z-10"></div>
             <img src={elHierroImg.src} alt="Productos de El Hierro en Tenerife" class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-110 transition duration-700" loading="lazy"/>
             <div class="absolute bottom-0 left-0 p-6 z-20 text-white w-full">
                <div class="bg-yellow-500 text-black text-xs font-bold px-2 py-1 rounded inline-block mb-2">Exclusivo</div>
                <h3 class="text-2xl md:text-3xl font-bold mb-2 flex items-center gap-2">Sabor Herreño <Icon name="ArrowRight" size={24} className="opacity-0 group-hover:opacity-100 transition-opacity -translate-x-4 group-hover:translate-x-0 duration-300"/></h3>
                <p class="text-gray-200 text-sm md:text-base opacity-90 leading-relaxed">
                  Traemos la isla a Tenerife: <strong>Quesadillas</strong>, Piña Tropical de Frontera y Queso ahumado. Stock semanal.
                </p>
             </div>
          </a>

          <!-- Card Profesionales (Cash & Carry) -->
          <a href="/profesionales" class="group relative overflow-hidden rounded-3xl h-80 md:h-96 shadow-md hover:shadow-2xl transition-all duration-500 block md:col-span-2 lg:col-span-1 border-2 border-transparent hover:border-green-500">
             <div class="absolute inset-0 bg-slate-900 z-10"></div>
             <!-- Decorative pattern -->
             <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] z-10"></div>
             
             <div class="absolute inset-0 z-20 flex flex-col justify-center items-center text-center p-8 text-white h-full">
                <div class="w-16 h-16 bg-green-600 rounded-full flex items-center justify-center mb-6 shadow-lg group-hover:scale-110 transition-transform">
                   <Icon name="Store" size={32} className="text-white"/>
                </div>
                <h3 class="text-2xl md:text-3xl font-bold mb-3">Zona Profesionales</h3>
                <p class="text-slate-300 text-sm md:text-base mb-6 max-w-xs mx-auto">
                  Soluciones integrales para Hostelería, Restauración y Grandes Consumidores. Pedidos personalizados y tarifas especiales.
                </p>
                <span class="inline-flex items-center gap-2 bg-white text-slate-900 px-6 py-3 rounded-xl font-bold text-sm group-hover:bg-green-400 group-hover:text-green-900 transition-colors shadow-lg">
                  Solicitar Tarifas HORECA <Icon name="ArrowRight" size={16}/>
                </span>
             </div>
          </a>
       </div>
    </Section>

    <!-- Why Choose Us Grid -->
    <Section class="bg-white">
       <div class="container mx-auto px-4">
         <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-12">
            <div class="text-center group">
               <div class="w-20 h-20 bg-green-50 text-green-700 rounded-3xl flex items-center justify-center mx-auto mb-4 text-4xl shadow-sm group-hover:bg-green-600 group-hover:text-white transition-all duration-300">🥩</div>
               <h3 class="font-bold text-gray-900 text-lg">Corte a Cuchillo</h3>
               <p class="text-sm text-gray-500 mt-2">Carniceros expertos, no bandejas industriales.</p>
            </div>
            <div class="text-center group">
               <div class="w-20 h-20 bg-yellow-50 text-yellow-700 rounded-3xl flex items-center justify-center mx-auto mb-4 text-4xl shadow-sm group-hover:bg-yellow-500 group-hover:text-white transition-all duration-300">🏷️</div>
               <h3 class="font-bold text-gray-900 text-lg">Precios Mayoristas</h3>
               <p class="text-sm text-gray-500 mt-2">Ahorra comprando formatos grandes sin carnet.</p>
            </div>
            <div class="text-center group">
               <div class="w-20 h-20 bg-blue-50 text-blue-700 rounded-3xl flex items-center justify-center mx-auto mb-4 text-4xl shadow-sm group-hover:bg-blue-600 group-hover:text-white transition-all duration-300">📅</div>
               <h3 class="font-bold text-gray-900 text-lg">Abierto 362 Días</h3>
               <p class="text-sm text-gray-500 mt-2">Domingos, festivos... siempre abiertos para ti.</p>
            </div>
            <div class="text-center group">
               <div class="w-20 h-20 bg-red-50 text-red-700 rounded-3xl flex items-center justify-center mx-auto mb-4 text-4xl shadow-sm group-hover:bg-red-600 group-hover:text-white transition-all duration-300">❤️</div>
               <h3 class="font-bold text-gray-900 text-lg">100% Canario</h3>
               <p class="text-sm text-gray-500 mt-2">Empresa familiar de aquí, cerca de ti.</p>
            </div>
         </div>
       </div>
    </Section>

    <!-- Blog & News Widgets -->
    <div class="bg-gray-50 border-t border-gray-200">
      <ContentWidget 
          title="Consejos, Recetas y Actualidad" 
          subtitle="Blog Terencio"
          collection="blog" 
          maxItems={3} 
          bgClass="bg-transparent"
          viewAllLink="/blog"
          viewAllText="Ver todo el Blog"
      />
    </div>

    <!-- FAQ Section (SEO-rich) -->
    <Section class="bg-white">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <span class="text-green-700 font-bold uppercase tracking-widest text-sm">Preguntas Frecuentes</span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mt-2 mb-4">Todo lo que necesitas saber</h2>
          <p class="text-gray-600 max-w-2xl mx-auto">Resolvemos las dudas más comunes sobre nuestro supermercado Cash & Carry en La Esperanza</p>
        </div>

        <div class="space-y-6">
          <!-- FAQ 1 -->
          <div class="bg-gray-50 rounded-2xl p-6 md:p-8 border border-gray-200">
            <h3 class="text-xl font-bold text-gray-900 mb-3 flex items-start gap-3">
              <Icon name="MessageCircleQuestionMark" size={24} className="text-green-600 shrink-0 mt-1" />
              ¿Necesito carnet de socio para comprar en Terencio?
            </h3>
            <p class="text-gray-700 leading-relaxed ml-0 md:ml-9">
              <strong>No</strong>, somos un <strong>Cash & Carry abierto a todos</strong> sin necesidad de membresía. Tanto particulares como profesionales pueden comprar libremente nuestros productos a precios mayoristas sin cuotas ni carnets. Esta es nuestra gran diferencia frente a otros almacenes mayoristas en Tenerife.
            </p>
          </div>

          <!-- FAQ 2 -->
          <div class="bg-gray-50 rounded-2xl p-6 md:p-8 border border-gray-200">
            <h3 class="text-xl font-bold text-gray-900 mb-3 flex items-start gap-3">
              <Icon name="Store" size={24} className="text-green-600 shrink-0 mt-1" />
              ¿Qué es un Cash & Carry y cómo funciona?
            </h3>
            <p class="text-gray-700 leading-relaxed ml-0 md:ml-9">
              Un <strong>Cash & Carry</strong> es un modelo de supermercado <strong>autoservicio mayorista</strong> donde compras productos en <strong>formatos grandes</strong> a <strong>precios más bajos</strong> que en supermercados tradicionales. Vienes, seleccionas lo que necesitas, pagas al contado o con tarjeta, y te lo llevas tú mismo. En Terencio no exigimos carnet, por lo que familias y autónomos ahorran sin barreras.
            </p>
          </div>

          <!-- FAQ 3 -->
          <div class="bg-gray-50 rounded-2xl p-6 md:p-8 border border-gray-200">
            <h3 class="text-xl font-bold text-gray-900 mb-3 flex items-start gap-3">
              <Icon name="MapPin" size={24} className="text-green-600 shrink-0 mt-1" />
              ¿Dónde está ubicado Terencio Cash Market?
            </h3>
            <p class="text-gray-700 leading-relaxed ml-0 md:ml-9">
              Estamos en <strong>Ctra. La Esperanza, 22</strong>, ubicación estratégica entre <strong>La Laguna y Santa Cruz</strong>. Fácil acceso desde la autopista del norte con <strong>parking gratuito</strong> amplio para coches, furgonetas y vehículos comerciales. Ideal para clientes de todo el norte de Tenerife.
            </p>
          </div>

          <!-- FAQ 4 -->
          <div class="bg-gray-50 rounded-2xl p-6 md:p-8 border border-gray-200">
            <h3 class="text-xl font-bold text-gray-900 mb-3 flex items-start gap-3">
              <Icon name="Clock" size={24} className="text-green-600 shrink-0 mt-1" />
              ¿Qué días y horarios abren?
            </h3>
            <p class="text-gray-700 leading-relaxed ml-0 md:ml-9">
              Abrimos <strong>362 días al año</strong>, incluidos <strong>domingos y festivos</strong> (cerramos solo Navidad, Año Nuevo y Reyes). Nuestro horario extendido está pensado para que puedas comprar cuando más te convenga. Consulta nuestros <a href="/horario" class="text-green-700 font-bold hover:underline">horarios completos aquí</a>.
            </p>
          </div>

          <!-- FAQ 5 -->
          <div class="bg-gray-50 rounded-2xl p-6 md:p-8 border border-gray-200">
            <h3 class="text-xl font-bold text-gray-900 mb-3 flex items-start gap-3">
              <Icon name="UtensilsCrossed" size={24} className="text-green-600 shrink-0 mt-1" />
              ¿Tienen carnicería propia?
            </h3>
            <p class="text-gray-700 leading-relaxed ml-0 md:ml-9">
              Sí, contamos con <strong>carnicería propia con carniceros profesionales</strong> que realizan <strong>despiece diario y corte a cuchillo</strong>. Somos especialistas en <strong>Carne de Fiesta</strong>, el corte canario tradicional perfecto para parrilladas, guachinches y celebraciones familiares. Descubre más en nuestra <a href="/carniceria-tenerife" class="text-green-700 font-bold hover:underline">sección de carnicería</a>.
            </p>
          </div>

          <!-- FAQ 6 -->
          <div class="bg-gray-50 rounded-2xl p-6 md:p-8 border border-gray-200">
            <h3 class="text-xl font-bold text-gray-900 mb-3 flex items-start gap-3">
              <Icon name="TreePalm" size={24} className="text-green-600 shrink-0 mt-1" />
              ¿Venden productos de El Hierro?
            </h3>
            <p class="text-gray-700 leading-relaxed ml-0 md:ml-9">
              Sí, traemos cada semana <strong>productos exclusivos de El Hierro</strong>: <strong>quesadillas herreñas artesanales</strong>, queso ahumado de Frontera y piña tropical de la isla. Son productos difíciles de encontrar en Tenerife y mantenemos stock permanente. Conoce toda nuestra selección en <a href="/productos-el-hierro-tenerife" class="text-green-700 font-bold hover:underline">Productos de El Hierro</a>.
            </p>
          </div>
        </div>
      </div>
    </Section>

    <!-- Professional Services Section -->
    <Section class="bg-gradient-to-br from-slate-900 to-slate-800 text-white">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <span class="text-green-400 font-bold uppercase tracking-widest text-sm">Sector HORECA</span>
          <h2 class="text-3xl md:text-4xl font-bold mt-2 mb-4">Servicio Especializado para Profesionales</h2>
        </div>

        <div class="prose prose-lg prose-invert max-w-none">
          <p class="text-slate-200 text-base md:text-lg leading-relaxed mb-6">
            Si tienes un <strong>restaurante, bar, cafetería, guachinche o cualquier negocio de hostelería</strong> en Tenerife, en Terencio encontrarás tu proveedor de confianza. Ofrecemos <strong>soluciones integrales</strong> para el sector HORECA con un catálogo completo de <strong>alimentación, bebidas, productos de limpieza y menaje profesional</strong>.
          </p>

          <p class="text-slate-200 text-base md:text-lg leading-relaxed mb-6">
            Trabajamos con <strong>tarifas especiales B2B</strong> y atención personalizada para pedidos grandes. Puedes realizar tus pedidos por teléfono o venir directamente a nuestras instalaciones en La Esperanza, donde disponemos de <strong>zonas de carga cómodas</strong> para vehículos comerciales y furgonetas. <strong>No realizamos reparto a domicilio</strong>, pero nuestro amplio parking y acceso directo desde la autopista hacen que recoger tu pedido sea rápido y sencillo.
          </p>

          <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 md:p-8 mt-8 border border-white/20">
            <p class="text-slate-100 mb-6 text-center md:text-left">
              <strong class="text-lg">¿Necesitas más información sobre nuestras tarifas profesionales?</strong>
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
              <a href="/profesionales" class="inline-flex items-center justify-center gap-2 bg-green-600 text-white px-8 py-4 rounded-xl font-bold hover:bg-green-500 transition-all shadow-lg hover:shadow-xl">
                <Icon name="FileText" size={20} />
                Ver Servicios HORECA
              </a>
              <a href="tel:922636026" class="inline-flex items-center justify-center gap-2 bg-white text-slate-900 px-8 py-4 rounded-xl font-bold hover:bg-gray-100 transition-all shadow-lg">
                <Icon name="Phone" size={20} />
                Llamar Ahora
              </a>
            </div>
          </div>
        </div>
      </div>
    </Section>

    <!-- Google Reviews -->
    <GoogleReviews />
    
    <!-- Strategic Location Section (SEO-rich) -->
    <Section class="bg-gray-50">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <span class="text-green-700 font-bold uppercase tracking-widest text-sm">Nuestra Ubicación</span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mt-2 mb-4">Estratégicamente Situados en La Esperanza</h2>
        </div>

        <div class="prose prose-lg max-w-none text-gray-700 mb-8">
          <p class="text-base md:text-lg leading-relaxed mb-4">
            Terencio Cash Market está ubicado en <strong>Ctra. La Esperanza, 22</strong>, una localización privilegiada que nos convierte en el supermercado mayorista más accesible para clientes de <strong>La Laguna, Santa Cruz y todo el norte de Tenerife</strong>. Nuestra posición en la subida principal a La Esperanza, con <strong>fácil acceso desde la autopista del norte (TF-5)</strong>, te permite llegar rápidamente sin complicaciones de tráfico urbano.
          </p>

          <p class="text-base md:text-lg leading-relaxed mb-4">
            Disponemos de <strong>amplio parking gratuito propio</strong> con espacio suficiente para coches particulares, furgonetas de autónomos y vehículos comerciales de profesionales. Esta comodidad es ideal tanto para familias que hacen la compra mensual como para restaurantes y negocios que necesitan cargar pedidos grandes. Olvídate de buscar aparcamiento o pagar parquímetros: aquí aparcas gratis y sin estrés.
          </p>

          <p class="text-base md:text-lg leading-relaxed">
            Nuestra cercanía a zonas residenciales como <strong>San Cristóbal de La Laguna, Taco, La Cuesta</strong> y <strong>Santa Cruz centro</strong> nos convierte en la opción preferida de miles de familias canarias. Además, servimos de almacén de emergencia para guachinches, bares y restaurantes de toda la zona que necesitan productos urgentes los fines de semana o festivos cuando otros proveedores están cerrados.
          </p>
        </div>
      </div>
    </Section>

    <!-- Location -->
    <LocationSection className="bg-white pt-0 pb-16" />
  </main>
</Layout>