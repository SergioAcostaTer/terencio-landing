---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ServiceCard from "../components/ServiceCard.astro";
import LocationMap from "../components/LocationMap.astro";
import NewsGrid from "../components/NewsGrid.astro";
import Reviews from "../components/Reviews.astro";
import services from "../data/services.json";
import { getCollection } from "astro:content";

const latestPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Títulos optimizados para Search Console (Tenerife, La Esperanza, Mayorista)
const title = "Terencio Cash Market | Supermercado y Mayorista en La Esperanza, Tenerife";
const description = "Terencio Cash Market es tu supermercado barato en La Esperanza y mayorista de hostelería en Tenerife. Especialistas en carnicería fresca, productos canarios y ahorro familiar.";
---

<Layout title={title} description={description}>
  <main>
    <Hero />


    <!-- INTRO EXTENDIDA: Para palabras clave de "Supermercado barato" y "La Laguna" -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4 grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-6">
            Tu compra inteligente en el <span class="text-green-700">Norte de Tenerife</span>
          </h2>
          <div class="prose prose-lg text-gray-600">
            <p>
              ¿Buscas un <strong>supermercado en La Esperanza</strong> con precios de almacén? En Terencio Cash Market combinamos la atención de una tienda de barrio con la potencia de un <strong>Cash and Carry</strong>.
            </p>
            <p>
              Somos el proveedor de confianza para cientos de bares y restaurantes en <strong>San Cristóbal de La Laguna</strong> y Santa Cruz. Ofrecemos desde el despiece de carne fresca hasta productos de limpieza industrial, todo en un solo lugar con fácil aparcamiento.
            </p>
          </div>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/ofertas" class="bg-red-600 text-white px-6 py-3 rounded-lg font-bold hover:bg-red-700 shadow-md">Ver Ofertas Semanales</a>
            <a href="/profesionales" class="border-2 border-green-700 text-green-700 px-6 py-3 rounded-lg font-bold hover:bg-green-700 hover:text-white">Zona Mayorista</a>
          </div>
        </div>
        <div class="relative">
          <img src="/imagenes/supermercado-interior.webp" alt="Interior Terencio Supermercado" class="rounded-3xl shadow-2xl" onerror="this.src='https://images.unsplash.com/photo-1542838132-92c53300491e?q=80&w=2574&auto=format&fit=crop'">
          <div class="absolute -bottom-6 -left-6 bg-white p-6 rounded-2xl shadow-xl hidden md:block border border-gray-100">
            <p class="text-green-700 font-bold text-2xl">Ahorro real</p>
            <p class="text-gray-500 text-sm">Sin necesidad de tarjeta de socio</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICIOS -->
    <section class="py-12">
      <div class="container mx-auto px-4">
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {services.map(service => (
            <ServiceCard 
              title={service.title} 
              description={service.description} 
              icon={service.icon} 
              link={service.link}
            />
          ))}
        </div>
      </div>
    </section>

        <!-- SECCIÓN ESTRATÉGICA: Categorías de mayor búsqueda (SEO Semántico) -->
    <section class="py-12 bg-white">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-8">
          <div class="group text-center p-4 border border-gray-100 rounded-2xl hover:bg-red-50 transition-colors">
            <span class="text-4xl mb-2 block">🥩</span>
            <h3 class="font-bold text-gray-900">Carnicería</h3>
            <p class="text-xs text-gray-500">Cortes frescos diarios</p>
          </div>
          <div class="group text-center p-4 border border-gray-100 rounded-2xl hover:bg-green-50 transition-colors">
            <span class="text-4xl mb-2 block">🍷</span>
            <h3 class="font-bold text-gray-900">Bodega XL</h3>
            <p class="text-xs text-gray-500">Vinos y Licores</p>
          </div>
          <div class="group text-center p-4 border border-gray-100 rounded-2xl hover:bg-yellow-50 transition-colors">
            <span class="text-4xl mb-2 block">🧀</span>
            <h3 class="font-bold text-gray-900">Productos Canarios</h3>
            <p class="text-xs text-gray-500">Directo de las islas</p>
          </div>
          <div class="group text-center p-4 border border-gray-100 rounded-2xl hover:bg-blue-50 transition-colors">
            <span class="text-4xl mb-2 block">📦</span>
            <h3 class="font-bold text-gray-900">Mayorista HORECA</h3>
            <p class="text-xs text-gray-500">Formatos Ahorro</p>
          </div>
        </div>
      </div>
    </section>


    <!-- NOTICIAS Y BLOG -->
    <section class="py-16 bg-white border-t border-gray-100">
        <div class="container mx-auto px-4">
            <div class="flex flex-col md:flex-row justify-between items-center mb-10">
                <h2 class="text-3xl font-bold text-gray-900 mb-4 md:mb-0">Actualidad y Consejos de Ahorro</h2>
                <a href="/blog" class="text-green-700 font-bold hover:underline flex items-center gap-2">Ir al Blog <span class="text-xl">→</span></a>
            </div>
            <NewsGrid />
        </div>
    </section>

    <!-- MAPA -->
    <section id="donde-estamos" class="py-16 bg-gray-50">
        <div class="container mx-auto px-4">
            <div class="text-center mb-10">
                <h2 class="text-3xl font-bold text-gray-900">Ubicación Estratégica</h2>
                <p class="text-gray-600 mt-2">En la Carretera de La Esperanza, a 5 minutos de La Laguna.</p>
            </div>
            <LocationMap />
        </div>
    </section>

    <Reviews />
  </main>
</Layout>