---
import heroBg from "../assets/images/hero-bg.webp";
import supermercadoInterior from "../assets/images/supermercado-interior.webp";

import Hero from "../components/Hero.astro";
import LocationSection from "../components/LocationSection.astro";
import LocalBusinessSchema from "../components/SEO/LocalBusinessSchema.astro";
import Icon from "../components/ui/Icon";
import Section from "../components/ui/Section.astro";
import ContentWidget from "../components/widgets/ContentWidget.astro";
import GoogleReviews from "../components/widgets/GoogleReviews.astro";
import Layout from "../layouts/Layout.astro";

const title = "Terencio Cash Market | Supermercado en Tenerife (La Esperanza)";
const description = "Terencio Cash Market: Supermercado cerca de mi en La Esperanza y Mayorista líder en Tenerife. Venta a particulares y profesionales. Carne fresca, productos del El Hierro.";
---

<LocalBusinessSchema />
<Layout title={title} description={description} image={supermercadoInterior.src} preloadImage={heroBg.src}>
  <main>
    <Hero 
      title="Terencio Cash Market: Supermercado en <span class='text-green-400'>La Esperanza</span> y Mayorista en <span class='text-yellow-400'>Tenerife</span>"
      subtitle="Compra diaria para particulares y venta mayorista para hostelería. Carnicería propia, productos frescos y precios de almacén."
      badge="📍 Abierto TODOS los días"
      primaryCta={{ text: "Ver Ofertas", href: "/ofertas" }}
      secondaryCta={{ text: "Zona Profesionales", href: "/profesionales" }}
      backgroundImage={heroBg}
    />

    <!-- Bloque de Iconos -->
    <div class="bg-green-800 text-white py-6 shadow-sm relative z-20">
      <div class="container mx-auto px-4">
        <div class="flex flex-wrap justify-center items-center gap-6 md:gap-16 text-sm md:text-lg font-bold uppercase tracking-wider text-center">
          <span class="flex items-center gap-3">
             <span class="text-2xl">📅</span> Abierto Domingos
          </span>
          <span class="flex items-center gap-3">
             <span class="text-2xl">🅿️</span> Parking Gratis
          </span>
          <span class="flex items-center gap-3">
             <span class="text-2xl">🆔</span> Sin Carnet
          </span>
        </div>
      </div>
    </div>

    <!-- Cards Section -->
    <Section class="bg-white">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          <a href="/carniceria-tenerife" class="block cursor-pointer group">
            <div class="flex flex-col items-center text-center p-8 bg-red-50 rounded-3xl border border-red-100 hover:shadow-xl transition h-full">
              <div class="text-6xl mb-6 group-hover:scale-110 transition">🥩</div>
              <h3 class="text-3xl font-bold mb-3 text-gray-900">Carnicería</h3>
              <p class="text-gray-600 mb-6 font-medium">Carne fresca, despiece propio y corte a cuchillo.</p>
              <span class="text-red-700 font-bold mt-auto flex items-center gap-2">Ver Carnicería <Icon name="ArrowRight" size={20}/></span>
            </div>
          </a>

          <a href="/productos-el-hierro-tenerife" class="block cursor-pointer group">
            <div class="flex flex-col items-center text-center p-8 bg-green-50 rounded-3xl border border-green-100 hover:shadow-xl transition h-full">
              <div class="text-6xl mb-6 group-hover:scale-110 transition">🍍</div>
              <h3 class="text-3xl font-bold mb-3 text-gray-900">Productos El Hierro</h3>
              <p class="text-gray-600 mb-6 font-medium">Quesadillas, piña, quesos y los sabores de la isla.</p>
              <span class="text-green-700 font-bold mt-auto flex items-center gap-2">Ver Productos <Icon name="ArrowRight" size={20}/></span>
            </div>
          </a>
        </div>
    </Section>

    <!-- NewsGrid Widget -->
    <ContentWidget 
        title="Actualidad Terencio" 
        subtitle="Corporativo"
        collection="noticias" 
        maxItems={3} 
        bgClass="bg-gray-50 border-t border-gray-100"
    />

    <!-- Blog Widget (Ahorro y Consejos) -->
    <ContentWidget 
        title="Consejos de Ahorro y Recetas" 
        subtitle="Blog"
        collection="blog" 
        maxItems={3} 
        bgClass="bg-white"
    />

    <!-- Location Section -->
    <LocationSection />

    <!-- Google Reviews (New) -->
    <GoogleReviews />
  </main>
</Layout>