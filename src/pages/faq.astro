---
import FAQ from "../components/FAQ.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Layout from "../layouts/Layout.astro";

const title = "Preguntas Frecuentes - Terencio Cash Market";
const description = "Resolvemos tus dudas sobre Terencio Cash Market. Horarios, acceso a particulares, servicio a domicilio y más.";
---

<Layout title={title} description={description}>
  <PageHeader 
    title="Preguntas Frecuentes" 
    subtitle="Resolvemos las dudas más habituales sobre compras, horarios y servicios."
    badge="Ayuda"
  />

  <div class="py-12 bg-white">
    <FAQ />
  </div>

  <section class="bg-green-50 py-16 text-center">
    <div class="container mx-auto px-4">
      <h3 class="text-2xl font-bold text-gray-900 mb-4">¿No encuentras lo que buscas?</h3>
      <a href="/contacto" class="text-green-700 font-bold hover:underline text-lg">
        Escríbenos directamente &rarr;
      </a>
    </div>
  </section>
</Layout>
