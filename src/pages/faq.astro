---
import FAQ from "../components/FAQ.astro";
import Layout from "../layouts/Layout.astro";

const title = "Preguntas Frecuentes - Terencio Cash Market";
const description = "Resolvemos tus dudas sobre Terencio Cash Market. Horarios, acceso a particulares, servicio a domicilio y más.";
---

<Layout title={title} description={description}>
  <header class="bg-gray-100 py-16 text-center">
    <div class="container mx-auto px-4">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Preguntas Frecuentes</h1>
      <p class="text-gray-600 max-w-2xl mx-auto">
        Todo lo que necesitas saber antes de visitarnos. Si no encuentras tu respuesta, contáctanos.
      </p>
    </div>
  </header>

  <div class="py-12 bg-white">
    <FAQ />
  </div>

  <section class="bg-green-50 py-16 text-center">
    <div class="container mx-auto px-4">
      <h3 class="text-2xl font-bold text-gray-900 mb-4">¿No encuentras lo que buscas?</h3>
      <a href="/contacto" class="text-green-700 font-bold hover:underline text-lg">
        Escríbenos directamente &rarr;
      </a>
    </div>
  </section>
</Layout>
