---
import LocationMap from "../components/LocationMap.astro";
import LocalBusinessSchema from "../components/SEO/LocalBusinessSchema.astro";
import Button from "../components/ui/Button.astro";
import Section from "../components/ui/Section.astro";
import Layout from "../layouts/Layout.astro";

const title = "Carnicería Cerca de Mí en La Laguna | Terencio Cash Market";
const description = "¿Buscas una carnicería de confianza cerca de La Laguna? Terencio te ofrece carne fresca al corte, chuletones madurados y carne de fiesta. Parking gratis.";
---

<LocalBusinessSchema type="GroceryStore" name="Carnicería Terencio" description={description} />
<Layout title={title} description={description}>
  
  <header class="bg-red-50 py-16">
    <div class="container mx-auto px-4 text-center">
        <span class="text-red-600 font-bold uppercase tracking-widest text-sm">Carnicería Tradicional</span>
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mt-2 mb-6">Tu Carnicería de Confianza cerca de La Laguna</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
            A solo unos minutos del centro de La Laguna, recuperamos el trato personal de la carnicería de barrio con precios de cash & carry.
        </p>
    </div>
  </header>

  <Section class="bg-white">
    <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4">¿Qué nos hace diferentes?</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-8 text-center px-4">
        <div>
            <span class="text-5xl block mb-4">🔪</span>
            <h3 class="font-bold text-xl mb-2">Corte Personalizado</h3>
            <p class="text-gray-600">Tú eliges el grosor y la pieza. Nuestros maestros carniceros te asesoran.</p>
        </div>
        <div>
            <span class="text-5xl block mb-4">🔥</span>
            <h3 class="font-bold text-xl mb-2">Especial Barbacoas</h3>
            <p class="text-gray-600">Chuletones, costillas adobadas, chistorras y la auténtica Carne de Fiesta.</p>
        </div>
        <div>
            <span class="text-5xl block mb-4">❄️</span>
            <h3 class="font-bold text-xl mb-2">Frescura Garantizada</h3>
            <p class="text-gray-600">Rotación diaria de producto. Si no es fresco, no está en nuestro mostrador.</p>
        </div>
    </div>
  </Section>

  <Section class="bg-gray-50">
    <div class="grid md:grid-cols-2 gap-12 items-center">
         <div class="h-[400px] rounded-2xl overflow-hidden shadow-xl">
             <LocationMap title="Ubicación Carnicería Terencio" />
        </div>
        <div>
            <h2 class="text-3xl font-bold mb-6">Ven a vernos hoy</h2>
            <p class="text-gray-600 mb-6">
                Estamos en la Carretera de La Esperanza, con fácil aparcamiento. Compra tu carne y el resto de la compra del supermercado en un solo viaje.
            </p>
            <div class="space-y-4">
                <Button href="https://www.google.com/maps/search/?api=1&query=Terencio+Cash+Market" target="_blank" variant="primary" class="w-full justify-center gap-2">
                    📍 Cómo llegar (Google Maps)
                </Button>
                <Button href="tel:922550067" variant="outline" class="w-full justify-center">
                    📞 Llamar para Encargos
                </Button>
            </div>
        </div>
    </div>
  </Section>

</Layout>
