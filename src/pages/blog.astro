---
import blogData from "../data/blogData.json";
import Layout from "../layouts/Layout.astro";

const articles = blogData.articles;
---

<Layout title="Blog">
  <section class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {
      articles.map((article) => (
        <a href={`/blog/${article.slug}`}>
          <article class="p-4 bg-white shadow-md rounded-xl border border-gray-300">
            <img src={article.image_url} alt={article.title} class="mb-2 rounded-xl aspect-[16/9]" transition:name={`blog-${article.title}-image`} />
            <div class="h-16 flex items-center">
              <h3 class="text-lg font-semibold mb-2" transition:name={`blog-${article.title}-title`}>
                {article.title}</h3>
            </div>
            <p class="text-sm text-gray-500 mb-2" transition:name={`blog-${article.title}-date`}>
                {article.date}</p>
            {/* <p>{article.content}</p> */}
          </article>
        </a>
      ))
    }
  </section>
</Layout>
