---
import Layout from "../layouts/Layout.astro";

const title = "Ofertas Semanales - Terencio Cash Market Tenerife";
const description = "Descubre las mejores ofertas de la semana en alimentación, frescos y bebidas. Precios especiales para profesionales y particulares en La Esperanza.";
---

<Layout title={title} description={description}>
  <div class="container mx-auto px-4 py-16 text-center">
    <span class="material-icons-outlined text-6xl text-red-500 mb-6">local_offer</span>
    <h1 class="text-4xl font-bold text-gray-900 mb-6">Ofertas de la Semana</h1>
    <p class="text-xl text-gray-600 mb-12 max-w-2xl mx-auto">
      Estamos actualizando nuestro folleto digital. Visítanos en tienda para descubrir más de 100 productos con precios rebajados esta semana.
    </p>

    <!-- Placeholder for visual flyer -->
    <div class="max-w-4xl mx-auto bg-gray-100 rounded-xl p-12 border-2 border-dashed border-gray-300 flex flex-col items-center justify-center min-h-[400px]">
      <div class="text-center">
          <h3 class="text-2xl font-bold text-gray-700 mb-4">Folleto Digital Próximamente</h3>
          <p class="text-gray-500 mb-6">Síguenos en redes sociales para enterarte de todas las novedades.</p>
          <a href="/contacto" class="bg-green-700 text-white px-8 py-3 rounded-lg font-bold hover:bg-green-800 transition shadow-lg">
            Consultar horario y ubicación
          </a>
      </div>
    </div>
  </div>
</Layout>
