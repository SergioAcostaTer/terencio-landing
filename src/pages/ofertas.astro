---
import Layout from "../layouts/Layout.astro";

const title = "Ofertas Semanales - Terencio Cash Market Tenerife";
const description = "Descubre las mejores ofertas de la semana en alimentación, frescos y bebidas. Precios especiales para profesionales y particulares en La Esperanza.";
---

<Layout title={title} description={description}>
  <div class="container mx-auto px-4 py-16 text-center">
    <span class="material-icons-outlined text-6xl text-red-500 mb-6">local_offer</span>
    <h1 class="text-4xl font-bold text-gray-900 mb-6">Ofertas de la Semana</h1>
    <p class="text-xl text-gray-600 mb-12 max-w-2xl mx-auto">
      Estamos actualizando nuestro folleto digital. Visítanos en tienda para descubrir más de 100 productos con precios rebajados esta semana.
    </p>

    <!-- Placeholder for visual flyer -->
    <!-- Visual Flyer / Offers Section -->
    <div class="max-w-4xl mx-auto bg-white rounded-xl shadow-lg overflow-hidden border border-gray-100">
       <div class="bg-red-600 p-4 text-white font-bold text-center">
          FOLLETO VIGENTE
       </div>
       <div class="p-8 md:p-12 flex flex-col items-center justify-center min-h-[300px] bg-gray-50">
          <span class="material-icons-outlined text-6xl text-gray-300 mb-4">picture_as_pdf</span>
          <h3 class="text-2xl font-bold text-gray-800 mb-2">Nuevo Folleto en camino</h3>
          <p class="text-gray-500 mb-8 max-w-md">Estamos preparando las mejores ofertas para esta quincena. Suscríbete para recibirlas antes que nadie.</p>
          
          <div class="flex flex-col sm:flex-row gap-4 w-full max-w-md justify-center">
             <a href="https://wa.me/34922550067?text=Hola,%20quiero%20recibir%20las%20ofertas" target="_blank" class="flex items-center justify-center gap-2 bg-green-600 text-white px-6 py-3 rounded-lg font-bold hover:bg-green-700 transition shadow-md w-full">
                <span class="material-icons-outlined">chat</span>
                Recibir en WhatsApp
             </a>
             <button disabled class="flex items-center justify-center gap-2 bg-gray-200 text-gray-400 px-6 py-3 rounded-lg font-bold cursor-not-allowed w-full">
                <span class="material-icons-outlined">file_download</span>
                Descargar PDF
             </button>
          </div>
       </div>
    </div>
  </div>
</Layout>
