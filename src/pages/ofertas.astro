---
import PageHeader from "../components/ui/PageHeader.astro";
import offers from "../data/offers.json";
import Layout from "../layouts/Layout.astro";

const title = "Ofertas Semanales | Terencio Cash Market";
const description = "Descubre las mejores ofertas de la semana en Terencio. Precios de mayorista en carnicería, frescos, bodega y limpieza.";
---

<Layout title={title} description={description}>
  
  <PageHeader 
    title='Ofertas <span class="text-yellow-400">Destacadas</span>'
    subtitle="Precios válidos hasta fin de existencias. Aprovecha nuestras bajadas de precio semanales."
    badge="Ofertas Semana"
  />

  <!-- Offers Grid -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
        
        <!-- Filter/Category Tabs (Visual only for now) -->
        <div class="flex flex-wrap justify-center gap-4 mb-12">
            <button class="px-6 py-2 bg-green-700 text-white rounded-full font-bold shadow-md ring-2 ring-green-700 ring-offset-2">Todo</button>
            <button class="px-6 py-2 bg-white text-gray-600 rounded-full font-bold shadow-sm hover:bg-green-50 transition">Frescos</button>
            <button class="px-6 py-2 bg-white text-gray-600 rounded-full font-bold shadow-sm hover:bg-green-50 transition">Bodega</button>
            <button class="px-6 py-2 bg-white text-gray-600 rounded-full font-bold shadow-sm hover:bg-green-50 transition">Limpieza</button>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {offers.map(offer => (
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-xl transition-all group flex flex-col h-full relative">
                    {/* Badge */}
                    {offer.highlight && (
                        <div class="absolute top-3 left-3 bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full z-10 shadow-sm animate-pulse">
                            {offer.highlight}
                        </div>
                    )}
                    
                    {/* Image Area - Placeholder if no image */}
                    <div class="h-48 bg-gray-100 relative overflow-hidden flex items-center justify-center">
                        <span class="text-6xl group-hover:scale-110 transition duration-500">
                           {offer.category === 'Frescos' ? '🥬' : 
                            offer.category === 'Carnicería' ? '🥩' :
                            offer.category === 'Bodega' ? '🍷' : '🧼'}
                        </span>
                        {/* <img src={offer.image} alt={offer.name} class="w-full h-full object-cover" /> */}
                    </div>

                    <div class="p-5 flex flex-col flex-grow">
                        <div class="text-xs font-bold text-green-700 uppercase tracking-wider mb-1">{offer.category}</div>
                        <h3 class="font-bold text-gray-900 text-lg leading-tight mb-2 line-clamp-2">{offer.name}</h3>
                        <p class="text-sm text-gray-500 mb-4 line-clamp-2">{offer.description}</p>
                        
                        <div class="mt-auto flex items-end justify-between border-t border-gray-100 pt-4">
                            <div>
                                <span class="text-gray-400 line-through text-sm font-medium">{offer.oldPrice}€</span>
                                <div class="text-2xl font-black text-red-600 leading-none">
                                    {offer.price}€
                                </div>
                                {offer.unit && <span class="text-xs text-gray-500">/{offer.unit}</span>}
                            </div>
                        </div>
                    </div>
                </div>
            ))}
        </div>

    </div>
  </section>
</Layout>
