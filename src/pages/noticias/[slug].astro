---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('noticias');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, image, pubDate, author, category } = post.data;
const { Content } = await post.render();

const formattedDate = pubDate.toLocaleDateString('es-ES', { 
    weekday: 'long', 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
});
---

<Layout title={title} description={description} image={image} type="article" publishDate={pubDate.toISOString()} author={author}>
  
  <article class="bg-white min-h-screen">
    
    <!-- Article Progress Bar (Optional nice to have) -->
    <div class="fixed top-0 left-0 w-full h-1 bg-gray-200 z-50">
        <div class="h-full bg-green-700 w-0" id="reading-progress"></div>
    </div>

    <!-- Header / Hero -->
    <header class="relative bg-gray-900 py-20 lg:py-32">
        <div class="absolute inset-0 overflow-hidden">
            <img src={image} alt={title} class="w-full h-full object-cover opacity-30 blur-sm scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/80 to-transparent"></div>
        </div>
        
        <div class="container mx-auto px-4 relative z-10 max-w-4xl text-center">
            <span class="inline-block py-1 px-3 rounded bg-green-600 text-white text-sm font-bold tracking-wider mb-6 uppercase">
                {category || 'Noticia Corporativa'}
            </span>
            <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
                {title}
            </h1>
            <div class="flex flex-col md:flex-row items-center justify-center gap-4 text-gray-300 text-lg">
                <span class="font-medium">{author}</span>
                <span class="hidden md:inline">•</span>
                <time datetime={pubDate.toISOString()}>{formattedDate}</time>
            </div>
        </div>
    </header>

    <!-- Content Container -->
    <div class="container mx-auto px-4 max-w-4xl -mt-10 relative z-20 pb-20">
        <!-- Main Image -->
        <div class="rounded-xl overflow-hidden shadow-2xl mb-12 bg-gray-200">
             <img src={image} alt={title} class="w-full h-auto max-h-[600px] object-cover" />
        </div>

        <div class="grid lg:grid-cols-[1fr_250px] gap-12">
            <!-- Main Text -->
            <div class="prose prose-lg prose-green max-w-none text-gray-700 leading-relaxed font-serif">
                <Content />
            </div>

            <!-- Side Share/Nav -->
            <aside class="hidden lg:block space-y-8 sticky top-24 h-fit">
                <div>
                    <h4 class="font-bold text-gray-900 mb-4 uppercase text-xs tracking-wider">Compartir</h4>
                    <div class="flex gap-2">
                        <!-- Social buttons placeholders -->
                        <button class="w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center hover:bg-blue-700">F</button>
                        <button class="w-10 h-10 rounded-full bg-sky-500 text-white flex items-center justify-center hover:bg-sky-600">T</button>
                        <button class="w-10 h-10 rounded-full bg-green-500 text-white flex items-center justify-center hover:bg-green-600">W</button>
                    </div>
                </div>
                
                <div class="border-t pt-8">
                     <h4 class="font-bold text-gray-900 mb-4 uppercase text-xs tracking-wider">Más en {category}</h4>
                     <!-- Usually we'd filter related posts here, static link for now -->
                     <a href="/noticias" class="text-green-700 text-sm font-bold hover:underline">Ver todas las noticias &rarr;</a>
                </div>
            </aside>
        </div>

    </div>

    <!-- Read Next -->
    <div class="bg-gray-50 py-16 border-t border-gray-200">
        <div class="container mx-auto px-4 max-w-6xl">
            <h3 class="text-2xl font-bold text-gray-900 mb-8">Sigue leyendo</h3>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                 {/* Placeholder for "Read Next" logic - using a link back to index for simplicity */}
                 <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100 flex flex-col items-center justify-center text-center h-48">
                    <p class="text-gray-500 mb-4">Descubre más novedades sobre Terencio</p>
                    <a href="/noticias" class="px-6 py-2 bg-gray-900 text-white rounded font-bold hover:bg-black transition">Ir a portada de Noticias</a>
                 </div>
            </div>
        </div>
    </div>

  </article>

  <script>
    // Simple reading progress bar
    window.addEventListener('scroll', () => {
        const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        const bar = document.getElementById("reading-progress");
        if(bar) bar.style.width = scrolled + "%";
    });
  </script>

</Layout>
