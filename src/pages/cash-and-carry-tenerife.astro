---
import interiorImage from "../assets/images/supermercado-interior.webp";
import LocationMap from "../components/LocationMap.astro";
import LocalBusinessSchema from "../components/SEO/LocalBusinessSchema.astro";
import Button from "../components/ui/Button.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Section from "../components/ui/Section.astro";
import ContentWidget from "../components/widgets/ContentWidget.astro";
import Layout from "../layouts/Layout.astro";

// SEO Title & Description
const title = "Cash and Carry en Tenerife: Compra sin Carnet | Terencio";
const description = "El único Cash & Carry en Tenerife abierto al público general. Sin carnet, sin cuotas. Precios de mayorista para familias y empresas en La Esperanza.";
---

<LocalBusinessSchema type="WholesaleStore" />
<Layout title={title} description={description} image={interiorImage.src}>
  
  <!-- Hero Section -->
  <PageHeader 
    title='Cash and Carry en Tenerife: <span class="text-green-300">Compra sin Carnet</span>'
    subtitle="El único centro mayorista donde <strong>particulares y profesionales</strong> compran al mismo precio. Sin cuotas, sin tarjetas, solo ahorro."
    badge="Ahorro Inteligente"
    backgroundImage={interiorImage.src}
  >
      <div class="flex flex-wrap gap-4 justify-center md:justify-start">
        <Button href="#como-funciona" variant="primary" class="text-lg px-8 py-4 shadow-xl hover:-translate-y-1 transition-all">
            ¿Cómo funciona?
        </Button>
        <Button href="/profesionales" variant="outline" class="text-lg px-8 py-4 border-white text-white hover:bg-white hover:text-green-900 shadow-xl hover:-translate-y-1 transition-all">
            Soy Profesional HORECA
        </Button>
      </div>
  </PageHeader>

  <!-- Value Proposition Grid -->
  <Section class="bg-white" id="como-funciona">
    <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">La revolución del Cash & Carry</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">Ya no necesitas ser empresa para acceder a precios de almacén. En Terencio hemos democratizado el ahorro.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
        <!-- Benefit 1 -->
        <div class="bg-gray-50 p-8 rounded-2xl border border-gray-100 hover:shadow-lg transition group">
            <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center text-4xl shadow-sm mb-6 group-hover:scale-110 transition">
                💳
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Sin Carnet de Socio</h3>
            <p class="text-gray-600">
                Olvídate de registros complicados o tarjetas de membresía (tipo Makro o Costco). Aquí las puertas están abiertas para todos.
            </p>
        </div>

        <!-- Benefit 2 -->
        <div class="bg-gray-50 p-8 rounded-2xl border border-gray-100 hover:shadow-lg transition group">
             <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center text-4xl shadow-sm mb-6 group-hover:scale-110 transition">
                📦
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Formatos Ahorro</h3>
            <p class="text-gray-600">
                Elige lo que necesitas: unidades sueltas para casa o cajas completas para tu negocio con precio escalado.
            </p>
        </div>

        <!-- Benefit 3 -->
        <div class="bg-gray-50 p-8 rounded-2xl border border-gray-100 hover:shadow-lg transition group">
             <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center text-4xl shadow-sm mb-6 group-hover:scale-110 transition">
                🥩
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Frescos de Calidad</h3>
            <p class="text-gray-600">
                No solo latas y limpieza. Tenemos una de las mejores carnicerías de Tenerife y charcutería al corte.
            </p>
        </div>
    </div>
  </Section>

  <!-- VS Competitors Table -->
  <Section class="bg-gray-900 text-white">
    <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-8 text-center text-white">Cash & Carry vs. Supermercado Normal</h2>
        
        <div class="overflow-hidden rounded-xl border border-gray-700">
            <table class="w-full text-left bg-gray-800">
                <thead class="bg-gray-700 text-gray-300 uppercase text-xs font-bold tracking-wider">
                    <tr>
                        <th class="p-6">Característica</th>
                        <th class="p-6 text-green-400">Terencio Cash Market</th>
                        <th class="p-6">Supermercado Típico</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-700">
                    <tr>
                        <td class="p-6 font-medium">Precio</td>
                        <td class="p-6 text-green-400 font-bold">Mayorista / Volumétrico</td>
                        <td class="p-6 text-gray-400">PVP Estándar</td>
                    </tr>
                    <tr>
                        <td class="p-6 font-medium">Carnet</td>
                        <td class="p-6 text-green-400 font-bold">No Necesario</td>
                        <td class="p-6 text-gray-400">No Necesario</td>
                    </tr>
                    <tr>
                        <td class="p-6 font-medium">Formatos</td>
                        <td class="p-6 text-green-400 font-bold">Industrial y Familiar</td>
                        <td class="p-6 text-gray-400">Pequeño / Familiar</td>
                    </tr>
                     <tr>
                        <td class="p-6 font-medium">Atención</td>
                        <td class="p-6 text-green-400 font-bold">Asesoramiento Profesional</td>
                        <td class="p-6 text-gray-400">Autoservicio general</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
  </Section>

  <!-- Blog Grid Widget -->
  <ContentWidget 
    title="Consejos para Ahorrar" 
    subtitle="Blog de Ahorro"
    collection="blog" 
    tags={['Ahorro', 'Consejos']}
    maxItems={3} 
    bgClass="bg-white border-t border-gray-100"
  />

  <!-- CTA Final -->
  <Section class="bg-white text-center">
    <h2 class="text-3xl font-bold mb-6">Haz la compra inteligente</h2>
    <p class="text-gray-600 mb-8 max-w-2xl mx-auto">Únete a miles de familias y negocios de Tenerife que ya ahorran cada mes en Terencio.</p>
    
    <div class="max-w-4xl mx-auto h-[300px] rounded-2xl overflow-hidden shadow-lg border border-gray-200 mb-8">
        <LocationMap title="Cómo llegar al Cash & Carry" />
    </div>

    <div class="flex flex-col sm:flex-row justify-center gap-4 mb-12">
        <Button href="https://www.google.com/maps/search/?api=1&query=Terencio+Cash+Market" target="_blank" variant="primary" class="gap-2">
            📍 Ver Ubicación en Maps
        </Button>
        <Button href="/terencio-cash-market" variant="ghost">
            Ver Productos
        </Button>
    </div>
  </Section>

</Layout>
