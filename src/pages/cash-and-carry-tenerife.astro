---
import interiorImage from "../assets/images/supermercado-interior.webp";
import LocationMap from "../components/LocationMap.astro";
import LocalBusinessSchema from "../components/SEO/LocalBusinessSchema.astro";
import Button from "../components/ui/Button.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Section from "../components/ui/Section.astro";
import Layout from "../layouts/Layout.astro";

// Keywords: cash and carry sin carnet, supermercado mayorista tenerife, comprar barato tenerife
const title = "Cash and Carry en Tenerife: Compra sin Carnet | Terencio";
const description = "El único Cash & Carry en Tenerife abierto al público general. Sin carnet, sin cuotas. Precios de mayorista para familias y empresas en La Esperanza.";
---

<LocalBusinessSchema type="WholesaleStore" />
<Layout title={title} description={description} image={interiorImage.src}>
  
  <PageHeader 
    title='Cash and Carry Tenerife: <span class="text-green-300">Abierto al Público</span>'
    subtitle="Rompemos las reglas del mayorista. Aquí particulares y empresas compran con precios de almacén sin necesidad de ser socios."
    badge="Ahorro Inteligente"
    backgroundImage={interiorImage.src}
  >
      <div class="flex flex-wrap gap-4 justify-center md:justify-start">
        <Button href="#ventajas" variant="primary" class="text-lg px-8 py-4 shadow-xl hover:-translate-y-1 transition-all bg-white text-green-900 hover:bg-green-50">
            Ver Ventajas
        </Button>
      </div>
  </PageHeader>

  <Section class="bg-white" id="ventajas">
    <div class="text-center mb-16">
        <span class="text-green-700 font-bold uppercase tracking-widest text-sm">Modelo Híbrido</span>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mt-2 mb-4">¿Por qué comprar aquí?</h2>
        <p class="text-gray-600 max-w-2xl mx-auto text-lg">La comodidad de un supermercado con los precios de un almacén mayorista.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
        <!-- Benefit 1 -->
        <div class="bg-green-50 p-8 rounded-3xl border border-green-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 group text-center">
            <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center text-4xl shadow-sm mb-6 group-hover:scale-110 transition mx-auto text-green-600 font-bold">
                🆔
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Sin Carnet ni Cuotas</h3>
            <p class="text-gray-600 leading-relaxed">
                No necesitas ser autónomo, ni empresa, ni registrarte en ningún club. Las puertas están abiertas para todos. Entra y compra.
            </p>
        </div>

        <!-- Benefit 2 -->
        <div class="bg-blue-50 p-8 rounded-3xl border border-blue-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 group text-center">
             <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center text-4xl shadow-sm mb-6 group-hover:scale-110 transition mx-auto">
                📦
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Formatos Familiares</h3>
            <p class="text-gray-600 leading-relaxed">
                Elige lo que necesitas: desde una unidad suelta para la cena hasta cajas completas para llenar la despensa y ahorrar a lo grande.
            </p>
        </div>

        <!-- Benefit 3 -->
        <div class="bg-red-50 p-8 rounded-3xl border border-red-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 group text-center">
             <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center text-4xl shadow-sm mb-6 group-hover:scale-110 transition mx-auto">
                🥩
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Calidad Fresca</h3>
            <p class="text-gray-600 leading-relaxed">
                A diferencia de otros Cash que solo tienen seco, nosotros destacamos por nuestra carnicería al corte y frutería local diaria.
            </p>
        </div>
    </div>
  </Section>

  <!-- Comparison Table (SEO Goldmine for "supermercado barato") -->
  <Section class="bg-slate-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-green-900/20 to-slate-900 pointer-events-none"></div>
    <div class="max-w-4xl mx-auto relative z-10">
        <h2 class="text-3xl md:text-4xl font-bold mb-10 text-center">Terencio vs. Supermercado Típico</h2>
        
        <div class="overflow-hidden rounded-3xl border border-slate-700 bg-slate-800 shadow-2xl">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-700/50">
                        <th class="p-6 md:p-8 text-slate-400 font-medium uppercase tracking-wider text-sm">Comparativa</th>
                        <th class="p-6 md:p-8 text-green-400 font-bold text-xl text-center bg-slate-700/80">Terencio Cash Market</th>
                        <th class="p-6 md:p-8 text-slate-400 text-center font-medium">Otros Supermercados</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-700">
                    <tr class="hover:bg-slate-700/30 transition">
                        <td class="p-6 md:p-8 font-bold text-lg">Precio</td>
                        <td class="p-6 md:p-8 text-center font-bold text-green-400 bg-slate-700/30 text-lg">Mayorista / Ahorro</td>
                        <td class="p-6 md:p-8 text-center text-slate-300">Minorista (PVP alto)</td>
                    </tr>
                    <tr class="hover:bg-slate-700/30 transition">
                        <td class="p-6 md:p-8 font-bold text-lg">Acceso</td>
                        <td class="p-6 md:p-8 text-center font-bold text-green-400 bg-slate-700/30 text-lg">Libre (Sin Carnet)</td>
                        <td class="p-6 md:p-8 text-center text-slate-300">Libre o con Tarjeta Fidelidad</td>
                    </tr>
                    <tr class="hover:bg-slate-700/30 transition">
                        <td class="p-6 md:p-8 font-bold text-lg">Domingos</td>
                        <td class="p-6 md:p-8 text-center font-bold text-green-400 bg-slate-700/30 text-lg">ABIERTO</td>
                        <td class="p-6 md:p-8 text-center text-slate-300">Cerrado generalmente</td>
                    </tr>
                    <tr class="hover:bg-slate-700/30 transition">
                        <td class="p-6 md:p-8 font-bold text-lg">Carne</td>
                        <td class="p-6 md:p-8 text-center font-bold text-green-400 bg-slate-700/30 text-lg">Despiece Propio</td>
                        <td class="p-6 md:p-8 text-center text-slate-300">Bandejas industriales</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
  </Section>

  <Section class="bg-white text-center">
    <h2 class="text-3xl font-bold mb-6 text-gray-900">Ubicación Estratégica</h2>
    <p class="text-gray-600 mb-8 max-w-2xl mx-auto text-lg">En la subida a La Esperanza (La Laguna). Fácil aparcamiento gratuito en la puerta para cargar tu compra sin estrés.</p>
    
    <div class="max-w-5xl mx-auto h-[400px] rounded-3xl overflow-hidden shadow-2xl border-4 border-white mb-10">
        <LocationMap title="Cómo llegar al Cash & Carry" />
    </div>

    <div class="flex flex-col sm:flex-row justify-center gap-4">
        <Button href="https://www.google.com/maps/search/?api=1&query=Terencio+Cash+Market" target="_blank" variant="primary" class="gap-2 shadow-xl hover:-translate-y-1">
            📍 Navegar con Google Maps
        </Button>
        <Button href="/horario" variant="secondary" class="gap-2 shadow-xl hover:-translate-y-1 bg-white text-green-700 border border-green-200 hover:bg-green-50">
            🕒 Ver Horarios
        </Button>
    </div>
  </Section>

</Layout>