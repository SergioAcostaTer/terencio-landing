---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Empleo">
  <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-center mb-6 text-green-700 md:mt-14">
    Sé parte del proyecto <span class="text-red-600">Terencio</span>
  </h1>

  <p class="text-lg md:text-xl lg:text-2xl text-green-700 mt-4 font-semibold text-center">
    En Terencio Supermercados estamos en constante crecimiento y buscamos
    personas comprometidas y con ganas de trabajar.
  </p>

  <div class="flex flex-col items-center justify-center gap-4 pt-8">
    <p class="text-lg md:text-xl lg:text-2xl text-green-700 text-center">
      Si le resulta necesario, puede descargar el formulario de solicitud de
      empleo en el siguiente enlace.
    </p>

    <a href="/cv.pdf" target="_blank" class="flex flex-col items-center justify-center">
      <img src="/pdf.png" alt="Empleo" class="w-20 m-0" />
      <p class="text-lg md:text-xl lg:text-2xl text-red-500 animate-fadein mt-2 mb-0 text-center">
        Toque el icono para descargar el formulario de solicitud de empleo.
      </p>
    </a>
  </div>

  <div class="flex flex-col items-center justify-center pt-6">
    <a
      class="bg-green-700 text-white font-semibold py-2 px-4 rounded-lg w-48 text-center hover:bg-green-800 transition duration-300"
      href="mailto:info@kitcash.es?subject=CV%20-%20Terencio%20Supermercados"
      target="_blank"
    >
      Enviar CV
    </a>
  </div>
</Layout>
