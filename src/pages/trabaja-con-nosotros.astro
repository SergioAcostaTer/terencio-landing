---
import teamImage from "../assets/images-unoptimized/visita-estudiantes-bachillerato.jpg"; // Reutilizando imagen
import Icon from "../components/ui/Icon";
import PageHeader from "../components/ui/PageHeader.astro";
import siteData from "../data/siteData.json";
import Layout from "../layouts/Layout.astro";

const title = "Empleo en Terencio Cash Market | Trabaja en La Esperanza";
const description = "Únete al equipo de Terencio. Buscamos cajeros, reponedores, carniceros y personal de oficina. Envía tu CV y crece con una empresa líder en Tenerife.";

const benefits = [
    { title: "Estabilidad", desc: "Contratos de larga duración y crecimiento interno.", icon: "ShieldCheck" },
    { title: "Formación", desc: "Aprendizaje continuo en carnicería y gestión.", icon: "BookOpen" },
    { title: "Buen Ambiente", desc: "Somos una gran familia. Trato cercano y humano.", icon: "Smile" },
    { title: "Descuentos", desc: "Ventajas exclusivas para empleados en sus compras.", icon: "Tag" }
];

const departments = [
    { name: "Caja y Reposición", icon: "ShoppingCart" },
    { name: "Carnicería y Frescos", icon: "Beef" },
    { name: "Almacén y Logística", icon: "Truck" },
    { name: "Oficinas y Gestión", icon: "Computer" }
];
---

<Layout title={title} description={description} image={teamImage.src}>
  
  <PageHeader 
    title="Tu Futuro Empieza <span class='text-yellow-300'>Aquí</span>" 
    subtitle="Buscamos personas con actitud, ganas de aprender y vocación de servicio. ¿Eres tú?"
    badge="Portal de Talento"
    backgroundImage={teamImage.src}
    bgClass="bg-green-900"
  />

  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4">
        
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-3xl font-bold text-gray-900 mb-4">¿Por qué trabajar en Terencio?</h2>
            <p class="text-gray-600 text-lg">No somos solo un supermercado, somos un referente en La Esperanza y Tenerife. Valoramos el talento local y cuidamos de nuestra gente.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 mb-20">
            {benefits.map(benefit => (
                <div class="p-6 bg-green-50 rounded-2xl border border-green-100 text-center hover:-translate-y-2 transition-transform duration-300">
                    <div class="w-14 h-14 bg-white text-green-700 rounded-full flex items-center justify-center mx-auto mb-4 shadow-sm">
                        <Icon name={benefit.icon as any} size={28} />
                    </div>
                    <h3 class="font-bold text-lg text-gray-900 mb-2">{benefit.title}</h3>
                    <p class="text-sm text-gray-600">{benefit.desc}</p>
                </div>
            ))}
        </div>

        <!-- Departments Grid -->
        <div class="bg-slate-900 rounded-3xl p-8 md:p-16 text-white text-center relative overflow-hidden">
            <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"></div>
            
            <div class="relative z-10">
                <h2 class="text-3xl font-bold mb-12">Nuestros Departamentos</h2>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-12">
                    {departments.map(dept => (
                        <div class="p-4 rounded-xl bg-white/10 backdrop-blur-sm border border-white/10 hover:bg-white/20 transition group cursor-default">
                            <div class="mb-3 text-green-400 group-hover:scale-110 transition-transform inline-block">
                                <Icon name={dept.icon as any} size={40} />
                            </div>
                            <p class="font-bold">{dept.name}</p>
                        </div>
                    ))}
                </div>

                <div class="bg-white rounded-2xl p-8 max-w-2xl mx-auto text-gray-900 shadow-2xl">
                    <h3 class="text-2xl font-bold mb-4 flex items-center justify-center gap-2">
                        <Icon name="Send" className="text-green-600" />
                        Envíanos tu CV
                    </h3>
                    <p class="text-gray-600 mb-6">
                        Actualmente centralizamos la recepción de candidaturas por correo electrónico. Por favor, incluye tu CV en formato PDF y una breve carta de presentación.
                    </p>
                    
                    <a 
                        href={`mailto:${siteData.contact.email}?subject=Candidatura CV - Web Terencio`}
                        class="inline-flex w-full sm:w-auto items-center justify-center gap-2 bg-green-700 text-white px-8 py-4 rounded-xl font-bold hover:bg-green-800 transition shadow-lg text-lg"
                    >
                        <Icon name="Mail" />
                        Enviar Candidatura
                    </a>
                    <p class="text-xs text-gray-400 mt-4">
                        Al enviar tu email aceptas nuestra política de privacidad para procesos de selección.
                    </p>
                </div>
            </div>
        </div>

    </div>
  </section>

  <!-- Testimonial (Mockup for Social Proof) -->
  <section class="py-16 bg-gray-50 border-t border-gray-200">
      <div class="container mx-auto px-4 max-w-4xl text-center">
          <Icon name="Quote" size={48} className="text-green-200 mx-auto mb-6" />
          <blockquote class="text-xl md:text-2xl font-medium text-gray-700 italic mb-6">
              "Empecé como repositor en verano y ahora coordino la sección de frescos. En Terencio si tienes ganas de trabajar, tienes futuro."
          </blockquote>
          <cite class="not-italic font-bold text-gray-900 flex items-center justify-center gap-2">
              <div class="w-10 h-10 bg-gray-300 rounded-full flex items-center justify-center text-gray-600">JD</div>
              Juan D., Equipo Terencio
          </cite>
      </div>
  </section>

</Layout>