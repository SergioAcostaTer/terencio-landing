---
import Layout from '../layouts/Layout.astro';

const title = "Página no encontrada - Terencio Cash Market";
---

<Layout title={title}>
  <div class="min-h-[60vh] flex flex-col items-center justify-center text-center px-4">
    <h1 class="text-9xl font-bold text-green-100">404</h1>
    <h2 class="text-2xl font-bold text-gray-900 mt-4">Vaya, parece que te has perdido en el pasillo</h2>
    <p class="text-gray-600 mt-2">La página que buscas no existe o ha sido movida.</p>
    <div class="mt-8 flex flex-col sm:flex-row gap-4">
       <a href="/" class="bg-green-700 text-white px-6 py-3 rounded-lg font-bold hover:bg-green-800 transition">
         Volver al inicio
       </a>
       <a href="/contacto" class="bg-gray-100 text-gray-700 px-6 py-3 rounded-lg font-bold hover:bg-gray-200 transition">
         Contactar
       </a>
    </div>
  </div>
</Layout>
