---
import ContactForm from "../components/forms/ContactForm";
import LocationSection from "../components/LocationSection.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Section from "../components/ui/Section.astro";
import siteData from "../data/siteData.json";
import Layout from "../layouts/Layout.astro";

const title = "Contacto | Cash and Carry La Laguna y La Esperanza";
const description = "Contacta con Terencio Cash Market. Teléfono, email, ubicación en La Esperanza y formulario de contacto.";
---

<Layout title={title} description={description}>
  <PageHeader 
    title="Contacto" 
    subtitle="Estamos aquí para ayudarte. Visítanos o escríbenos."
    badge="Contacto"
  />

  <Section class="bg-white">
       <div class="grid lg:grid-cols-2 gap-12">
         
         <!-- Contact Info -->
         <div class="space-y-8">
            <div>
               <h2 class="text-2xl font-bold text-gray-900 mb-6">Información de Contacto</h2>
               <div class="space-y-6">
                 <div class="flex items-start gap-4">
                    <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center text-brand-primary flex-shrink-0">
                       <span class="material-icons-outlined">place</span>
                    </div>
                    <div>
                       <h3 class="font-bold text-gray-900 text-lg">Nuestra Tienda</h3>
                       <p class="text-gray-600">{siteData.address.streetAddress}</p>
                       <p class="text-gray-600">{siteData.address.addressLocality}, {siteData.address.addressRegion}</p>
                       <p class="text-gray-600">{siteData.address.postalCode}</p>
                    </div>
                 </div>

                 <div class="flex items-start gap-4">
                    <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center text-brand-primary flex-shrink-0">
                       <span class="material-icons-outlined">phone</span>
                    </div>
                    <div>
                       <h3 class="font-bold text-gray-900 text-lg">Teléfono</h3>
                       <p class="text-gray-600 text-lg">
                         <a href={`tel:${siteData.contact.phone.replace(/\s/g, "")}`} class="hover:text-brand-primary">{siteData.contact.phone}</a>
                       </p>
                       <p class="text-sm text-gray-500">Atención telefónica en horario comercial.</p>
                    </div>
                 </div>

                 <div class="flex items-start gap-4">
                    <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center text-brand-primary flex-shrink-0">
                       <span class="material-icons-outlined">email</span>
                    </div>
                    <div>
                       <h3 class="font-bold text-gray-900 text-lg">Email</h3>
                       <p class="text-gray-600">
                         <a href={`mailto:${siteData.contact.email}`} class="hover:text-brand-primary">{siteData.contact.email}</a>
                       </p>
                    </div>
                 </div>

                 <div class="flex items-start gap-4">
                    <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center text-brand-primary flex-shrink-0">
                       <span class="material-icons-outlined">schedule</span>
                    </div>
                    <div>
                       <h3 class="font-bold text-gray-900 text-lg">Horario</h3>
                       <p class="text-gray-600 mt-1">{siteData.hoursText}</p>
                       <p class="text-sm text-gray-500 mt-1">Abierto todos los días del año (consultar festivos especiales).</p>
                    </div>
                 </div>
               </div>
            </div>
            
            {/* LocationSection will be added at bottom */}
         </div>

         <!-- Contact Form -->
         <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Envíanos un mensaje</h2>
            <ContactForm client:load />
         </div>

       </div>
  </Section>

  <LocationSection />
</Layout>
