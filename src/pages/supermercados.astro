---
import { Image } from "astro:assets";
import localStoreImage from "../assets/supermercados-terencio.jpg";
import LocationMap from "../components/LocationMap.astro";
import siteData from "../data/siteData.json";
import Layout from "../layouts/Layout.astro";

const title = "Nuestros Supermercados - Terencio Cash Market";
const description = "Visita Terencio Cash Market en La Esperanza. Tu supermercado y Cash & Carry de referencia en Tenerife.";
---

<Layout title={title} description={description} canonical={`${siteData.url}/supermercados`}>
  <div class="bg-gray-100 py-12 text-center">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Nuestros Supermercados</h1>
      <p class="text-gray-600">Actualmente contamos con una gran superficie en Tenerife para ofrecerte el mejor servicio.</p>
    </div>
  </div>

  <section class="py-12 bg-white">
    <div class="container mx-auto px-4 max-w-5xl">
      <!-- Store Card -->
      <div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-200 flex flex-col md:flex-row">
        <div class="md:w-1/2 h-64 md:h-auto relative">
          <Image 
            src={localStoreImage} 
            alt="Terencio Cash Market La Esperanza" 
            class="w-full h-full object-cover absolute inset-0"
            width={800}
            format="webp"
          />
        </div>
        <div class="p-8 md:w-1/2 flex flex-col justify-center">
           <h2 class="text-2xl font-bold text-gray-900 mb-2">Terencio Cash Market</h2>
           <p class="text-green-700 font-semibold mb-4">La Esperanza, Tenerife</p>
           
           <div class="space-y-3 text-gray-600 mb-6">
             <p class="flex items-start gap-2">
               <span class="material-icons-outlined text-gray-400">location_on</span>
               <span>{siteData.address.streetAddress}, {siteData.address.addressLocality}</span>
             </p>
             <p class="flex items-center gap-2">
               <span class="material-icons-outlined text-gray-400">schedule</span>
               <span>{siteData.hoursText}</span>
             </p>
             <p class="flex items-center gap-2">
               <span class="material-icons-outlined text-gray-400">phone</span>
               <a href={`tel:${siteData.contact.phone.replace(/\s/g, "")}`} class="hover:text-green-700">{siteData.contact.phone}</a>
             </p>
           </div>

           <div class="flex gap-4">
             <a href="/terencio-cash-market" class="bg-green-700 text-white px-6 py-2 rounded-lg font-bold hover:bg-green-800 transition text-center flex-1">
               Ver detalles
             </a>
             <a href="/contacto" class="border border-gray-300 text-gray-700 px-6 py-2 rounded-lg font-bold hover:bg-gray-50 transition text-center flex-1">
               Cómo llegar
             </a>
           </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 bg-gray-50">
    <div class="container mx-auto px-4">
       <LocationMap />
    </div>
  </section>
</Layout>
