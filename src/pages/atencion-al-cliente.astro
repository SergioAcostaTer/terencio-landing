---
import FAQ from "../components/FAQ.astro";
import Layout from "../layouts/Layout.astro";

const title = "Atención al Cliente - Terencio Cash Market";
const description = "Centro de ayuda y atención al cliente de Terencio Supermercados. Resuelve tus dudas o contacta con nosotros.";
---

<Layout title={title} description={description}>
  <header class="bg-gray-100 py-16">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Atención al Cliente</h1>
      <p class="text-gray-600">¿En qué podemos ayudarte hoy?</p>
    </div>
  </header>

  <section class="py-12 bg-white">
     <div class="container mx-auto px-4 max-w-4xl">
        <FAQ />
     </div>
  </section>

  <section class="pb-16 pt-8">
     <div class="container mx-auto px-4 text-center">
        <h2 class="text-2xl font-bold mb-6">Contacta con soporte</h2>
        <div class="flex flex-wrap justify-center gap-6">
           <a href="/contacto" class="bg-white border border-gray-200 p-6 rounded-xl shadow-sm hover:shadow-md transition w-64 flex flex-col items-center">
              <span class="material-icons-outlined text-4xl text-green-700 mb-4">phone</span>
              <span class="font-bold text-gray-900">Teléfono</span>
              <span class="text-sm text-gray-500 mt-2">Llamar a tienda</span>
           </a>
           <a href="/contacto" class="bg-white border border-gray-200 p-6 rounded-xl shadow-sm hover:shadow-md transition w-64 flex flex-col items-center">
              <span class="material-icons-outlined text-4xl text-green-700 mb-4">email</span>
              <span class="font-bold text-gray-900">Email</span>
              <span class="text-sm text-gray-500 mt-2">Escribir un correo</span>
           </a>
           <a href="/contacto" class="bg-white border border-gray-200 p-6 rounded-xl shadow-sm hover:shadow-md transition w-64 flex flex-col items-center">
              <span class="material-icons-outlined text-4xl text-green-700 mb-4">store</span>
              <span class="font-bold text-gray-900">Tienda</span>
              <span class="text-sm text-gray-500 mt-2">Visítanos</span>
           </a>
        </div>
     </div>
  </section>
</Layout>
