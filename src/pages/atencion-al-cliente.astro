---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Atención al Cliente">
  <div class="flex flex-col items-center justify-center">
    <div class="items-center justify-center py-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="text-center flex flex-col items-center justify-center p-4 md:p-6">
        <img
          src="/atencion/atencion.png"
          alt="Atencio al cliente."
          class="w-32 md:w-40 lg:w-44 m-0"
        />
        <h1 class="font-worksans font-semibold text-2xl md:text-3xl lg:text-4xl text-[#01874D] animate-fadein m-0">
          Atención al cliente.
        </h1>
        <p class="font-montserrat font-medium text-lg md:text-xl lg:text-2xl text-[#01874D] animate-fadein mt-2 mb-0">
          Te atendemos personalmente desde Terencio Supermercados de lunes a
          domingo de 09:00 a 20:30. <br /><br />
          <a
            href="tel:922550067"
            target="_blank"
            class="font-worksans font-semibold text-lg md:text-xl lg:text-2xl text-[#01874D] underline animate-fadein"
            >922 55 00 67</a
          >
        </p>
      </div>
      <div class="text-center flex flex-col items-center justify-center p-4 md:p-6">
        <img
          src="/atencion/correo.png"
          alt="Correo electrónico."
          class="w-32 md:w-40 lg:w-44 m-0"
        />
        <h1 class="font-worksans font-semibold text-2xl md:text-3xl lg:text-4xl text-[#01874D] animate-fadein m-0">
          Correo electrónico.
        </h1>
        <p class="font-montserrat font-medium text-lg md:text-xl lg:text-2xl text-[#01874D] animate-fadein mt-2 mb-0">
          Puedes contarnos mediante el siguiente correo electrónico todas tu
          sugerencias o problemas. <br /><br />
          <a
            href="mailto:info@kitcash.es"
            target="_blank"
            class="font-worksans font-semibold text-lg md:text-xl lg:text-2xl text-[#01874D] underline animate-fadein"
            >info@kitcash.es</a
          >
        </p>
      </div>
      <div class="text-center flex flex-col items-center justify-center p-4 md:p-6">
        <img
          src="/atencion/redes.png"
          alt="Redes sociales."
          class="w-32 md:w-40 lg:w-44 m-0"
        />
        <h1 class="font-worksans font-semibold text-2xl md:text-3xl lg:text-4xl text-[#01874D] animate-fadein m-0">
          Redes sociales.
        </h1>
        <p class="font-montserrat font-medium text-lg md:text-xl lg:text-2xl text-[#01874D] animate-fadein mt-2 mb-0">
          También nos puedes contar cualquier cosa por nuestras redes sociales. <br
          /><br />
          <a
            href="http://instagram.com/terenciosupermercados"
            target="_blank"
            class="font-worksans font-semibold text-lg md:text-xl lg:text-2xl text-[#01874D] underline animate-fadein"
            >Instagram</a
          >
        </p>
      </div>
    </div>
  </div>
</Layout>
