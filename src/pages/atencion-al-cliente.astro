---
import FAQ from "../components/FAQ.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import siteData from "../data/siteData.json";
import Layout from "../layouts/Layout.astro";

const title = "Atención al Cliente y FAQ | Terencio Cash Market La Esperanza";
const description = "Ayuda y soporte de Terencio Cash Market. Consulta horarios, apertura en domingos, servicios para profesionales y ubicación de nuestro supermercado en Tenerife";
---

<Layout title={title} description={description}>
  <!-- Hero de Soporte -->
  <PageHeader 
    title="Atención al Cliente" 
    subtitle="Tu satisfacción es nuestra prioridad. Resolvemos tus dudas y escuchamos tus sugerencias."
    badge="Soporte"
  />

  <!-- Componente FAQ -->
  <section class="py-8 bg-white">
      <div class="container mx-auto">
        <FAQ />
      </div>
  </section>

  <!-- Canales de Contacto Directo -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-bold text-center mb-12 text-gray-900">Vías de contacto rápido</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Card Teléfono -->
          <a href={`tel:${siteData.contact.phoneRaw}`} class="block cursor-pointer group">
            <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 flex flex-col items-center text-center hover:shadow-xl transition-all">
              <div class="w-16 h-16 bg-green-100 text-green-700 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">Teléfono Tienda</h3>
              <p class="text-gray-500 text-sm mb-6">Para consultas rápidas sobre stock o pedidos.</p>
              <span class="text-green-700 font-extrabold text-xl group-hover:text-green-800 transition">
                {siteData.contact.phone}
              </span>
            </div>
          </a>

          <!-- Card Email -->
          <a href={`mailto:${siteData.contact.email}`} class="block cursor-pointer group">
            <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 flex flex-col items-center text-center hover:shadow-xl transition-all">
              <div class="w-16 h-16 bg-blue-100 text-blue-700 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">Correo Electrónico</h3>
              <p class="text-gray-500 text-sm mb-6">Para facturación y dudas administrativas.</p>
              <span class="text-blue-700 font-bold group-hover:underline">
                Enviar email
              </span>
            </div>
          </a>

          <!-- Card Ubicación -->
          <a href="https://www.google.com/maps/dir/?api=1&destination=Terencio+Cash+Market" target="_blank" class="block cursor-pointer group">
            <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 flex flex-col items-center text-center hover:shadow-xl transition-all">
              <div class="w-16 h-16 bg-red-100 text-red-700 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">Oficina Principal</h3>
              <p class="text-gray-500 text-sm mb-6">{siteData.address.streetAddress}, {siteData.address.locality}.</p>
              <span class="text-red-700 font-bold group-hover:underline">
                Ver en Mapa
              </span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Mensaje sobre pedidos -->
  <section class="py-16 bg-white border-t border-gray-100 text-center">
    <div class="container mx-auto px-4 max-w-3xl">
      <h2 class="text-2xl font-bold mb-4">¿Eres cliente profesional?</h2>
      <p class="text-gray-600 mb-8 leading-relaxed">
        Si gestionas un bar, restaurante o tienda y tienes dudas sobre las rutas de reparto o precios por volumen, contacta directamente con nuestro gestor comercial para una atención personalizada.
      </p>
      <a href="/profesionales" class="bg-slate-900 text-white px-8 py-3 rounded-xl font-bold hover:bg-slate-800 transition shadow-lg">
        Ir a la Zona Profesionales
      </a>
    </div>
  </section>
</Layout>