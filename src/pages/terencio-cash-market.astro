---
import Layout from "../layouts/Layout.astro";
import LocationMap from "../components/LocationMap.astro";
import ServiceCard from "../components/ServiceCard.astro";
import siteData from "../data/siteData.json";

const title = "Terencio Cash Market - Supermercado en La Esperanza, Tenerife";
const description = "Supermercado Terencio Cash Market en La Esperanza. Tu supermercado de confianza cerca de La Laguna. Ofertas diarias para todos los públicos.";

const seoAddress = `${siteData.address.streetAddress}, ${siteData.address.addressLocality}`;
---

<Layout title={title} description={description} canonical={`${siteData.url}/terencio-cash-market`}>
  <header class="bg-green-800 text-white py-16">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-3xl md:text-5xl font-bold mb-4">Terencio Cash Market</h1>
      <p class="text-xl text-green-100">La Esperanza, San Cristóbal de La Laguna</p>
    </div>
  </header>

  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-6">Tu Supermercado en La Esperanza</h2>
        <div class="prose text-gray-600 leading-relaxed mb-6">
          <p class="mb-4">
            <strong>Terencio Cash Market</strong> es el punto de encuentro para quienes buscan calidad y ahorro en el norte de Tenerife. Situados estratégicamente en la carretera de La Esperanza, ofrecemos un amplio surtido de productos de alimentación, bebidas y droguería.
          </p>
          <p class="mb-4">
            Nuestro establecimiento destaca por ser un formato híbrido: funcionamos como un supermercado tradicional para las familias y como un potente Cash & Carry para los negocios de la zona.
          </p>
          <ul class="list-disc pl-5 space-y-2 mt-4">
            <li><strong>Ubicación ideal:</strong> Fácil acceso desde La Laguna y autovía.</li>
            <li><strong>Aparcamiento propio:</strong> Haz tu compra cómodamente sin stress.</li>
            <li><strong>Precios competitivos:</strong> Ofertas semanales en primeras marcas.</li>
            <li><strong>Producto canario:</strong> Apostamos por lo nuestro (Quesos, Vinos, Frutas).</li>
          </ul>
        </div>
        <a href="#mapa" class="inline-block bg-green-700 text-white px-6 py-3 rounded-lg font-bold hover:bg-green-800 transition">
          Ver ubicación exacta
        </a>
      </div>
      <div>
        <img 
          src="/store-local.jpg" 
          alt="Fachada de Terencio Cash Market en La Esperanza" 
          class="rounded-xl shadow-lg w-full h-auto"
          onerror="this.src='https://images.unsplash.com/photo-1542838132-92c53300491e?q=80&w=2574&auto=format&fit=crop'"
        />
      </div>
    </div>
  </section>

  <section class="py-16 bg-gray-50">
     <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold text-gray-900 mb-12">¿Qué encontrarás aquí?</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
           <!-- Repeating simplified cards for content density -->
           <div class="bg-white p-6 rounded-lg shadow-sm">
             <span class="text-4xl block mb-2">🥗</span>
             <h3 class="font-bold">Frescos de Calidad</h3>
             <p class="text-sm text-gray-600">Fruta y verdura diaria.</p>
           </div>
           <div class="bg-white p-6 rounded-lg shadow-sm">
             <span class="text-4xl block mb-2">🧼</span>
             <h3 class="font-bold">Droguería</h3>
             <p class="text-sm text-gray-600">Hogar y limpieza profesional.</p>
           </div>
           <div class="bg-white p-6 rounded-lg shadow-sm">
             <span class="text-4xl block mb-2">🥩</span>
             <h3 class="font-bold">Carnicería</h3>
             <p class="text-sm text-gray-600">Cortes selectos al mejor precio.</p>
           </div>
           <div class="bg-white p-6 rounded-lg shadow-sm">
             <span class="text-4xl block mb-2">🍞</span>
             <h3 class="font-bold">Panadería</h3>
             <p class="text-sm text-gray-600">Pan recién horneado.</p>
           </div>
        </div>
     </div>
  </section>

  <section id="mapa" class="py-12 bg-white">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl font-bold text-center mb-8">Cómo llegar desde La Laguna</h2>
      <LocationMap />
      <div class="mt-8 text-center flex flex-col items-center">
         <p class="text-lg font-medium text-gray-800 mb-4">{seoAddress} - {siteData.address.postalCode}</p>
         
         <div class="flex flex-wrap justify-center gap-4">
            <a href="https://www.google.com/maps/dir//Terencio+Cash+Market+Carr.+de+la+Esperanza,+22+38206+La+Laguna+Santa+Cruz+de+Tenerife" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-blue-600 text-white px-6 py-3 rounded-lg font-bold hover:bg-blue-700 transition shadow-md hover:shadow-lg">
              <span class="material-icons-outlined">near_me</span>
              <span>Abrir GPS (Google Maps)</span>
            </a>
            <a href="tel:922550067" class="flex items-center gap-2 bg-white text-gray-800 border border-gray-300 px-6 py-3 rounded-lg font-bold hover:bg-gray-50 transition shadow-sm">
              <span class="material-icons-outlined text-green-700">call</span>
              <span>Llamar Ahora</span>
            </a>
         </div>

         <p class="text-gray-600 mt-6">Abierto todos los días de 09:00 a 20:30</p>
      </div>
    </div>
  </section>

</Layout>
