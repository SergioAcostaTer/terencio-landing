---
import proImage from "../assets/images/supermercado-interior.webp"; // Idealmente una foto de reparto o almacén
import ProfessionalForm from "../components/forms/ProfessionalForm";
import PageHeader from "../components/ui/PageHeader.astro";
import siteData from "../data/siteData.json";
import Layout from "../layouts/Layout.astro";

const title = "Proveedor HORECA Tenerife | Mayorista Alimentación y Bebidas";
const description = "Terencio Profesionales: Tu proveedor integral para hostelería en Tenerife. Alimentación, bebidas, limpieza y menaje. Reparto propio y precios netos competitivos.";
---

<Layout title={title} description={description} image={proImage.src}>
  
  <PageHeader 
    title="Proveedor Integral para <span class='text-green-300'>Hostelería</span>" 
    subtitle="Olvídate de tratar con 10 proveedores diferentes. Centraliza Alimentación, Bebidas, Limpieza y Menaje en un solo pedido, una sola factura y un solo reparto."
    badge="Zona B2B"
    backgroundImage={proImage.src}
    bgClass="bg-slate-900"
  >
    <div class="mt-8 bg-white p-6 md:p-8 rounded-3xl shadow-2xl max-w-lg mx-auto md:mx-0 border-t-8 border-brand-primary relative z-10 text-left">
        <div class="mb-6 border-b border-gray-100 pb-4">
            <h3 class="font-bold text-2xl text-gray-900 leading-tight">Solicita Tarifas Profesionales</h3>
            <p class="text-sm text-gray-500 mt-2">Rellena tus datos y nuestro gestor comercial te contactará en menos de 24h con precios personalizados.</p>
        </div>
        <ProfessionalForm client:visible />
    </div>
  </PageHeader>

  <!-- Pain Points / Solutions -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-brand-primary font-bold uppercase tracking-widest text-sm">Ventajas Competitivas</span>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mt-2 mb-6">¿Por qué cambiar a Terencio?</h2>
        <p class="text-lg text-gray-600">Sabemos que el margen es la clave. Eliminamos costes innecesarios para ofrecerte precios netos reales desde la primera caja.</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Benefit 1 -->
        <div class="p-8 bg-gray-50 rounded-3xl shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group">
            <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-3xl mb-6 shadow-sm group-hover:scale-110 transition text-brand-primary">⏱️</div>
            <h3 class="font-bold text-xl mb-3 text-gray-900">Servicio Urgente 362</h3>
            <p class="text-sm text-gray-600 leading-relaxed">Abrimos todos los días, incluidos domingos y festivos. Si te quedas sin hielo, pan o carne en pleno servicio, somos tu almacén de emergencia.</p>
        </div>
        <!-- Benefit 2 -->
        <div class="p-8 bg-gray-50 rounded-3xl shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group">
            <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-3xl mb-6 shadow-sm group-hover:scale-110 transition text-brand-primary">🧾</div>
            <h3 class="font-bold text-xl mb-3 text-gray-900">Factura Única</h3>
            <p class="text-sm text-gray-600 leading-relaxed">Simplifica tu contabilidad. Olvida tener 50 facturas pequeñas. Agrupamos tus compras para que tu gestión sea rápida y clara.</p>
        </div>
        <!-- Benefit 3 -->
        <div class="p-8 bg-gray-50 rounded-3xl shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group">
            <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-3xl mb-6 shadow-sm group-hover:scale-110 transition text-brand-primary">🚚</div>
            <h3 class="font-bold text-xl mb-3 text-gray-900">Reparto Propio</h3>
            <p class="text-sm text-gray-600 leading-relaxed">Flota propia con rutas diarias en La Laguna, Santa Cruz, Tegueste, El Rosario y zona norte. Llegamos a tu puerta.</p>
        </div>
        <!-- Benefit 4 -->
        <div class="p-8 bg-gray-50 rounded-3xl shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group">
            <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-3xl mb-6 shadow-sm group-hover:scale-110 transition text-brand-primary">💰</div>
            <h3 class="font-bold text-xl mb-3 text-gray-900">Precios Netos</h3>
            <p class="text-sm text-gray-600 leading-relaxed">Tarifas especiales por volumen sin rapels complejos ni costes ocultos. Precio final competitivo desde el principio.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Segmentos -->
  <section class="py-20 bg-gray-900 text-white relative overflow-hidden">
      <!-- Background Pattern -->
      <div class="absolute inset-0 opacity-5 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"></div>
      
      <div class="container mx-auto px-4 relative z-10">
          <div class="grid md:grid-cols-2 gap-12 items-center">
              <div>
                  <h2 class="text-3xl md:text-4xl font-bold mb-6">Soluciones a medida para tu negocio</h2>
                  <p class="text-gray-400 text-lg mb-8">No es lo mismo un restaurante de carta que una cafetería de paso. Adaptamos nuestro surtido a ti.</p>
                  
                  <div class="space-y-6">
                      <div class="flex gap-4 p-4 rounded-xl hover:bg-white/5 transition border border-transparent hover:border-white/10">
                          <span class="text-4xl">🍽️</span>
                          <div>
                              <h3 class="font-bold text-xl text-white">Restaurantes y Guachinches</h3>
                              <p class="text-gray-400 text-sm mt-1">Carne de fiesta, vinos locales (D.O. Tacoronte, Valle), aceites de 25L y productos frescos diarios.</p>
                          </div>
                      </div>
                      <div class="flex gap-4 p-4 rounded-xl hover:bg-white/5 transition border border-transparent hover:border-white/10">
                          <span class="text-4xl">☕</span>
                          <div>
                              <h3 class="font-bold text-xl text-white">Cafeterías y Bares</h3>
                              <p class="text-gray-400 text-sm mt-1">Leche, café, azucarillos, bollería, servilletas y todo para el desayuno y la merienda.</p>
                          </div>
                      </div>
                      <div class="flex gap-4 p-4 rounded-xl hover:bg-white/5 transition border border-transparent hover:border-white/10">
                          <span class="text-4xl">🏨</span>
                          <div>
                              <h3 class="font-bold text-xl text-white">Hoteles Rurales y Apts.</h3>
                              <p class="text-gray-400 text-sm mt-1">Amenities, limpieza industrial (garrafas 5L), papel higiénico y packs de bienvenida.</p>
                          </div>
                      </div>
                  </div>
              </div>
              
              <div class="bg-white text-gray-900 p-8 rounded-3xl shadow-2xl">
                  <h3 class="font-bold text-2xl mb-6">Catálogo Profesional</h3>
                  <div class="grid grid-cols-2 gap-4">
                      <div class="bg-gray-50 p-4 rounded-xl text-center border border-gray-100 hover:border-green-300 transition">
                          <div class="text-3xl mb-2">🍷</div>
                          <div class="font-bold text-sm">Bodega</div>
                      </div>
                      <div class="bg-gray-50 p-4 rounded-xl text-center border border-gray-100 hover:border-green-300 transition">
                          <div class="text-3xl mb-2">🧹</div>
                          <div class="font-bold text-sm">Limpieza</div>
                      </div>
                      <div class="bg-gray-50 p-4 rounded-xl text-center border border-gray-100 hover:border-green-300 transition">
                          <div class="text-3xl mb-2">🥩</div>
                          <div class="font-bold text-sm">Carnicería</div>
                      </div>
                      <div class="bg-gray-50 p-4 rounded-xl text-center border border-gray-100 hover:border-green-300 transition">
                          <div class="text-3xl mb-2">❄️</div>
                          <div class="font-bold text-sm">Congelados</div>
                      </div>
                      <div class="bg-gray-50 p-4 rounded-xl text-center border border-gray-100 hover:border-green-300 transition">
                          <div class="text-3xl mb-2">🥫</div>
                          <div class="font-bold text-sm">Secos</div>
                      </div>
                      <div class="bg-gray-50 p-4 rounded-xl text-center border border-gray-100 hover:border-green-300 transition">
                          <div class="text-3xl mb-2">🥤</div>
                          <div class="font-bold text-sm">Bebidas</div>
                      </div>
                  </div>
                  <div class="mt-8 text-center">
                      <p class="text-sm text-gray-500 mb-4">Más de 5.000 referencias en stock</p>
                      <a href="#contacto" class="block w-full bg-brand-primary text-white py-3 rounded-xl font-bold hover:bg-green-800 transition">Solicitar Catálogo PDF</a>
                  </div>
              </div>
          </div>
      </div>
  </section>

  <section class="py-16 bg-white border-t border-gray-200">
      <div class="container mx-auto px-4 text-center">
          <h2 class="text-3xl font-bold mb-8 text-gray-900">Zonas de Reparto Frecuente</h2>
          <div class="flex flex-wrap justify-center gap-3 max-w-4xl mx-auto mb-8">
              {siteData.areas.delivery.map(area => (
                  <span class="px-5 py-2 bg-green-50 text-green-800 rounded-full text-sm font-bold border border-green-100 hover:bg-green-100 transition cursor-default">
                      {area}
                  </span>
              ))}
          </div>
          <p class="text-gray-500 text-sm max-w-lg mx-auto">
            ¿Tu local está fuera de ruta? No te preocupes. Consúltanos, llegamos a casi toda la isla bajo pedido especial.
          </p>
      </div>
  </section>

</Layout>