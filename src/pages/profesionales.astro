---
import proImage from "../assets/supermercados-terencio.jpg";
import FAQ from "../components/FAQ.astro";
import ProfessionalForm from "../components/forms/ProfessionalForm";
import Button from "../components/ui/Button.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import ContentWidget from "../components/widgets/ContentWidget.astro";
import Layout from "../layouts/Layout.astro";

// SEO Optimizado
const title = "Proveedor de Hostelería en Tenerife | Mayorista Alimentación y Bebidas";
const description = "Terencio: Tu proveedor de hostelería en Tenerife. Alimentación, Bebidas, Limpieza y Menaje. Servicio de reparto y Cash & Carry en La Esperanza.";
---

<Layout title={title} description={description} image={proImage.src}>
  <PageHeader 
    title="Proveedor de Hostelería en Tenerife | Mayorista Alimentación y Bebidas" 
    subtitle="Servicio integral para HORECA. Suministro de alimentación, bebidas y limpieza con reparto propio y Cash & Carry."
    badge="Zona Profesionales"
    backgroundImage={proImage.src}
  >
    <div class="mt-8 bg-white p-6 rounded-xl shadow-xl max-w-lg mx-auto md:mx-0 border-t-4 border-green-600">
        <h3 class="font-bold text-gray-900 mb-2">🎁 Alta de Nuevo Cliente</h3>
        <p class="text-sm text-gray-600 mb-4">Date de alta hoy y accede a nuestras tarifas exclusivas para profesionales.</p>
        <ProfessionalForm client:visible />
    </div>
  </PageHeader>

  <!-- Ventajas B2B -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-3 gap-8 text-center">
        <div class="p-6 bg-green-50 rounded-2xl border border-green-100">
            <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center text-3xl mx-auto mb-4">⏱️</div>
            <h3 class="font-bold text-xl mb-2">Servicio de Urgencia</h3>
            <p class="text-gray-600">¿Te has quedado sin stock un domingo? Abrimos todos los días.</p>
        </div>
        <div class="p-6 bg-blue-50 rounded-2xl border border-blue-100">
            <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center text-3xl mx-auto mb-4">🧾</div>
            <h3 class="font-bold text-xl mb-2">Factura al Momento</h3>
            <p class="text-gray-600">Gestión administrativa ágil. Tus facturas disponibles al instante.</p>
        </div>
        <div class="p-6 bg-yellow-50 rounded-2xl border border-yellow-100">
            <div class="w-16 h-16 bg-yellow-100 rounded-full flex items-center justify-center text-3xl mx-auto mb-4">🚚</div>
            <h3 class="font-bold text-xl mb-2">Reparto Propio</h3>
            <p class="text-gray-600">Logística dedicada para profesionales en el área metropolitana.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Categorías Visuales -->
  <section class="py-16 bg-gray-50 border-t border-gray-200">
    <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-10">Nuestro Catálogo</h2>
        <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-md transition text-center group cursor-pointer border border-gray-100">
                <span class="text-5xl mb-4 block group-hover:scale-110 transition">🍷</span>
                <h3 class="font-bold text-xl text-gray-900">Bodega y Licores</h3>
                <p class="text-sm text-gray-500 mt-2">Vinos locales, destilados y refrescos.</p>
            </div>
            <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-md transition text-center group cursor-pointer border border-gray-100">
                <span class="text-5xl mb-4 block group-hover:scale-110 transition">🧹</span>
                <h3 class="font-bold text-xl text-gray-900">Limpieza Profesional</h3>
                <p class="text-sm text-gray-500 mt-2">Formatos industriales y químicos.</p>
            </div>
            <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-md transition text-center group cursor-pointer border border-gray-100">
                <span class="text-5xl mb-4 block group-hover:scale-110 transition">🥫</span>
                <h3 class="font-bold text-xl text-gray-900">Gran Formato</h3>
                <p class="text-sm text-gray-500 mt-2">Aceites, conservas y secos.</p>
            </div>
        </div>
        <div class="text-center mt-10">
            <Button href="#solicitar-tarifas" variant="primary">Solicitar Catálogo Completo</Button>
        </div>
    </div>
  </section>

  <!-- NewsGrid B2B -->
  <ContentWidget 
    title="Noticias para Empresas" 
    subtitle="Actualidad HORECA"
    collection="noticias" 
    category="Empresarial"
    maxItems={3} 
    bgClass="bg-white border-t border-gray-100"
  />

  <div class="py-12 bg-gray-50">
    <FAQ />
  </div>
</Layout>