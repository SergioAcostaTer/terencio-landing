---
import { Image } from "astro:assets";
import meatImage from "../assets/images-unoptimized/supermercado-interior.jpg"; // Using interior as fallback/context
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon";
import PageHeader from "../components/ui/PageHeader.astro";
import ContentWidget from "../components/widgets/ContentWidget.astro";
import Layout from "../layouts/Layout.astro";

const title = "Carnicería en Tenerife | Carne al por mayor y corte propio";
const description = "Tu carnicería de confianza en Tenerife. Despiece propio, carne fresca diaria y cortes especiales para Guachinches y Restaurantes. Venta a particulares y mayorista.";
const canonical = "https://terencio.es/carniceria-tenerife";
---

<Layout title={title} description={description} canonical={canonical} image={meatImage.src}>
  <!-- Hero Carnicería -->
  <PageHeader 
    title="Carnicería en Tenerife: Carne Fresca, Despiece Propio y Carne de Fiesta"
    subtitle="Tu carnicería tradicional en La Esperanza. Carne cortada a cuchillo y precios de almacén directos a ti."
    badge="Maestros Carniceros"
    badgeClass="bg-red-800/80 border border-red-400 text-red-100"
    backgroundImage={meatImage.src}
    bgClass="bg-red-900"
    gradientClass="bg-gradient-to-b from-red-900/90 via-red-900/60 to-red-900/90"
  />

  <!-- Características Principales y Explicación -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="relative">
             <Image src={meatImage} alt="Carne fresca al corte en Tenerife" class="relative z-10 rounded-xl shadow-2xl w-full h-auto object-cover border-b-8 border-red-700" width={600} height={400} />
             <div class="absolute -bottom-6 -right-6 bg-yellow-100 p-6 rounded-xl shadow-lg z-20 max-w-xs border border-yellow-200">
               <p class="text-red-900 font-bold text-xl mb-1">Precios de Almacén</p>
               <p class="text-sm text-gray-700">Sin intermediarios. Del matadero a Terencio.</p>
             </div>
        </div>
        
        <div class="prose prose-lg text-gray-600">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Corte a Cuchillo y Carne de Fiesta</h2>
          <p>
            En Terencio recuperamos el oficio tradicional. Nuestro equipo de carniceros realiza el <strong>despiece propio</strong> cada mañana, garantizando una frescura que ya no se encuentra en las grandes superficies.
          </p>
          <p>
            No vendemos bandejas industriales. Cuando nos pides <strong>Carne de Fiesta</strong>, la troceamos a cuchillo en el momento, consiguiendo ese corte limpio que mantiene todos los jugos al cocinarla.
          </p>
          <ul class="space-y-4 mt-6 not-prose">
            <li class="flex items-start gap-3">
              <Icon name="Check" className="text-red-600 mt-1" />
              <span><strong>Despiece diario:</strong> Género fresco cada día.</span>
            </li>
            <li class="flex items-start gap-3">
              <Icon name="Check" className="text-red-600 mt-1" />
              <span><strong>A tu gusto:</strong> Te preparamos el grosor y el corte exacto que necesitas.</span>
            </li>
            <li class="flex items-start gap-3">
               <Icon name="Check" className="text-red-600 mt-1" />
               <span><strong>Precios de Almacén:</strong> Al ser mayoristas, compras con tarifas muy ajustadas.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Lista de Precios Gancho -->
  <section class="py-16 bg-red-50">
      <div class="container mx-auto px-4 max-w-4xl">
          <div class="text-center mb-10">
              <h2 class="text-3xl font-bold text-gray-900 mb-2">Precios Imbatibles</h2>
              <p class="text-gray-600">Referencia de precios diarios (pueden variar según mercado)</p>
          </div>

          <div class="bg-white rounded-2xl shadow-sm border border-red-100 overflow-hidden">
              <div class="grid md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-gray-100">
                  <div class="p-6 text-center group hover:bg-red-50 transition">
                      <div class="text-4xl mb-3">🍗</div>
                      <h3 class="font-bold text-gray-900 mb-1">Pollo Entero</h3>
                      <p class="text-sm text-gray-500 mb-3">Fresco, gran tamaño</p>
                      <div class="text-2xl font-bold text-red-700">2,95 €/kg</div>
                  </div>
                  <div class="p-6 text-center group hover:bg-red-50 transition">
                      <div class="text-4xl mb-3">🥩</div>
                      <h3 class="font-bold text-gray-900 mb-1">Carne de Fiesta</h3>
                      <p class="text-sm text-gray-500 mb-3">Troceada a mano</p>
                      <div class="text-2xl font-bold text-red-700">5,90 €/kg</div>
                  </div>
                  <div class="p-6 text-center group hover:bg-red-50 transition">
                      <div class="text-4xl mb-3">🐷</div>
                      <h3 class="font-bold text-gray-900 mb-1">Chuleta Cerdo</h3>
                      <p class="text-sm text-gray-500 mb-3">Aguja o Lomo</p>
                      <div class="text-2xl font-bold text-red-700">4,50 €/kg</div>
                  </div>
              </div>
              <div class="bg-gray-50 p-4 text-center text-xs text-gray-500 border-t border-gray-100">
                  * Precios orientativos sujetos a variaciones de mercado. Visítanos para ver ofertas del día.
              </div>
          </div>
      </div>
  </section>

  <!-- Blog Grid Widget -->
  <ContentWidget 
    title="Recetas y Consejos de Carnicería" 
    subtitle="Aprende con nosotros"
    collection="blog" 
    tags={["Recetas", "Consejos"]}
    maxItems={3} 
    bgClass="bg-white"
  />

  <!-- CTA Simple Final -->
  <section class="py-12 bg-gray-900 text-white text-center">
    <div class="container mx-auto px-4">
        <h2 class="text-2xl font-bold mb-4">¿Quieres hacer un pedido grande?</h2>
        <p class="text-gray-300 mb-8 max-w-2xl mx-auto">Preparamos encargos para fiestas, barbacoas y eventos. Llámanos y tenlo listo para recoger.</p>
        <div class="flex flex-wrap justify-center gap-4">
             <Button href="/contacto" variant="primary">Ver Horarios y Ubicación</Button>
             <Button href="tel:922550067" variant="ghost" class="bg-white/10 text-white hover:bg-white/20">Llamar a Carnicería</Button>
        </div>
    </div>
  </section>
</Layout>