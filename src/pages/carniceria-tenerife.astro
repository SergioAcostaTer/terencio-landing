---
import { Image } from "astro:assets";
import meatImage from "../assets/images-unoptimized/supermercado-interior.jpg"; // Using interior as fallback/context
import Layout from "../layouts/Layout.astro";

const title = "Carnicería en Tenerife | Carne al por mayor y corte propio";
const description = "Tu carnicería de confianza en Tenerife. Despiece propio, carne fresca diaria y cortes especiales para Guachinches y Restaurantes. Venta a particulares y mayorista.";
const canonical = "https://terencio.es/carniceria-tenerife";
---

<Layout title={title} description={description} canonical={canonical} image={meatImage.src}>
  <!-- Hero Carnicería -->
  <section class="relative bg-red-900 text-white py-20 overflow-hidden">
    <div class="absolute inset-0 opacity-30 bg-[url('https://www.transparenttextures.com/patterns/dark-matter.png')]"></div>
    <div class="container mx-auto px-4 text-center relative z-10">
      <span class="material-icons-outlined text-6xl mb-4 text-red-300">restaurant</span>
      <h1 class="text-4xl md:text-6xl font-extrabold mb-6">La Carnicería de Terencio</h1>
      <p class="text-xl text-red-100 max-w-2xl mx-auto mb-8 font-light">
        Maestros carniceros con despiece propio. Calidad profesional al alcance de tu hogar y tu negocio.
      </p>
    </div>
  </section>

  <!-- Características Principales -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="relative">
             <div class="absolute -top-4 -left-4 w-24 h-24 bg-red-100 rounded-full z-0"></div>
             <Image src={meatImage} alt="Mostrador de Carnicería Terencio" class="relative z-10 rounded-xl shadow-2xl w-full h-auto object-cover border-b-8 border-red-700" width={600} height={400} />
             <div class="absolute bottom-4 right-4 bg-white p-4 rounded-lg shadow-lg z-20 max-w-xs border border-gray-100">
               <p class="text-red-700 font-bold text-lg">Frescura Diaria</p>
               <p class="text-xs text-gray-500">Recibimos género cada mañana.</p>
             </div>
        </div>
        
        <div class="prose prose-lg text-gray-600">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">¿Por qué comprar carne en Terencio?</h2>
          <p>
            Nos diferenciamos de las grandes superficies por nuestro trato y oficio. No solo vendemos bandejas; somos carniceros. Realizamos el <strong>despiece propio</strong> en nuestras instalaciones, lo que nos permite ofrecerte el corte exacto que necesitas.
          </p>
          <ul class="space-y-4 mt-6 not-prose">
            <li class="flex items-start gap-3">
              <span class="bg-red-100 text-red-700 p-1 rounded-full"><span class="material-icons-outlined text-sm">check</span></span>
              <span><strong>Carne fresca diaria:</strong> Nada de congelados industriales. Selección de las mejores granjas.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="bg-red-100 text-red-700 p-1 rounded-full"><span class="material-icons-outlined text-sm">check</span></span>
              <span><strong>Corte a cuchillo:</strong> Pídelo como te gusta. Fino para empanar, grueso para parrilla, troceado para estofado.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="bg-red-100 text-red-700 p-1 rounded-full"><span class="material-icons-outlined text-sm">check</span></span>
              <span><strong>Elaborados propios:</strong> Hamburguesas, salchichas y preparados cárnicos hechos en casa.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección Profesionales / Guachinches -->
  <section class="py-20 bg-gray-50 border-t border-gray-200">
    <div class="container mx-auto px-4">
      <div class="bg-white rounded-3xl shadow-xl overflow-hidden flex flex-col md:flex-row">
        <div class="p-10 md:w-2/3">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Especialistas en Hostelería y Guachinches</h2>
          <p class="text-gray-600 mb-6 text-lg">
             ¿Tienes un restaurante, asador o guachinche? Sabemos que la carne es el alma de tu negocio. En Terencio Cash Market ofrecemos condiciones especiales para <strong>carne al por mayor</strong>.
          </p>
          <div class="grid sm:grid-cols-2 gap-6 mb-8">
            <div class="bg-red-50 p-4 rounded-lg">
              <h4 class="font-bold text-red-800 mb-1">Chuletones y Parrilla</h4>
              <p class="text-sm text-gray-600">Cortes madurados y piezas enteras para brasas.</p>
            </div>
            <div class="bg-red-50 p-4 rounded-lg">
              <h4 class="font-bold text-red-800 mb-1">Carne de Fiesta</h4>
              <p class="text-sm text-gray-600">Tacos limpios y preparados para grandes volúmenes.</p>
            </div>
          </div>
          <a href="/profesionales" class="inline-block bg-red-700 text-white px-8 py-3 rounded-lg font-bold hover:bg-red-800 transition">
            Solicitar Tarifas Profesionales
          </a>
        </div>
        <div class="bg-gray-900 md:w-1/3 p-10 flex flex-col justify-center items-center text-center text-white">
          <span class="material-icons-outlined text-6xl mb-4 text-red-500">local_shipping</span>
          <h3 class="text-2xl font-bold mb-2">Reparto Propio</h3>
          <p class="text-gray-400">Servicio logístico para profesionales en Tenerife Norte y Metropolitana.</p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- CTA Final -->
  <section class="py-16 text-center">
    <div class="container mx-auto px-4">
       <h2 class="text-2xl font-bold mb-6">Visita nuestro mostrador en La Esperanza</h2>
       <p class="text-gray-600 mb-8">Abierto todos los días, domingos incluidos.</p>
       <a href="/contacto" class="text-red-700 font-bold hover:underline text-lg flex items-center justify-center gap-2">
         Ver ubicación y horarios
         <span class="material-icons-outlined">arrow_forward</span>
       </a>
    </div>
  </section>
</Layout>