---
import { Image } from "astro:assets";
import quesadillas from "../assets/images/quesadillas.webp";
import queso from "../assets/images/queso_mojo.webp";
import vinos from "../assets/images/vinos_el_hierro.webp";
import LocalBusinessSchema from "../components/SEO/LocalBusinessSchema.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import ContentWidget from "../components/widgets/ContentWidget.astro";
import Layout from "../layouts/Layout.astro";

const title = "Productos de El Hierro en Tenerife: Quesadillas, Vinos y Piña";
const description = "Compra productos de El Hierro en Tenerife: Quesadillas, Queso ahumado, Vinos y Piña tropical. Terencio Cash Market es tu conexión directa con la isla del Meridiano.";
const canonical = "https://terencio.es/productos-el-hierro-tenerife";
---

<LocalBusinessSchema description={description} image={quesadillas.src} />
<Layout title={title} description={description} canonical={canonical} image={quesadillas.src}>
  
  <PageHeader 
    title="Sabor Herreño: <span class='text-yellow-300'>Del Barco a tu Mesa</span>"
    subtitle="Somos el referente de productos de El Hierro en Tenerife. Quesadillas, quesos, vinos y la mejor piña tropical."
    badge="Origen Garantizado"
    badgeClass="bg-yellow-500/20 border border-yellow-500 text-yellow-200"
    backgroundImage={quesadillas.src}
    bgClass="bg-green-900"
    gradientClass="bg-gradient-to-b from-green-900/90 via-green-900/60 to-green-900/90"
  />

  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="prose prose-lg text-gray-600">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Tu Supermercado Herreño en Tenerife</h2>
          <p>
            Nuestra historia comenzó en El Hierro, y nunca hemos perdido esa conexión. Gracias a nuestra logística propia, traemos semanalmente lo mejor de la isla del Meridiano a La Esperanza.
          </p>
          <p>
            Muchos clientes de Santa Cruz y La Laguna vienen buscando específicamente nuestras <strong>Quesadillas de Adrián</strong>, el <strong>Queso Ahumado</strong> de la cooperativa y, por supuesto, la <strong>Piña Tropical</strong> de Frontera, famosa por su dulzor.
          </p>
          <div class="bg-yellow-50 p-4 rounded-lg border-l-4 border-yellow-500 mt-4">
             <p class="italic text-yellow-900 m-0 text-sm">"Si tienes morriña de la isla o simplemente te gusta lo bueno, este es tu sitio."</p>
          </div>
        </div>
        
        <div class="grid grid-cols-2 gap-4">
            <Image src={quesadillas} alt="Quesadillas Herreñas" class="rounded-xl shadow-lg w-full h-48 object-cover transform translate-y-4" width={300} height={200} />
            <Image src={vinos} alt="Vinos El Hierro" class="rounded-xl shadow-lg w-full h-48 object-cover transform -translate-y-4" width={300} height={200} />
        </div>
      </div>
    </div>
  </section>

  <!-- Product Showcase -->
  <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4">
          <h2 class="text-3xl font-bold text-center mb-12">Nuestra Selección</h2>
          
          <div class="grid md:grid-cols-3 gap-8">
              <!-- Item 1 -->
              <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition group">
                  <div class="h-56 overflow-hidden relative">
                      <Image src={quesadillas} alt="Quesadillas" class="w-full h-full object-cover group-hover:scale-110 transition duration-700"/>
                      <div class="absolute top-4 right-4 bg-yellow-400 text-black text-xs font-bold px-3 py-1 rounded-full">Dulce</div>
                  </div>
                  <div class="p-6">
                      <h3 class="font-bold text-xl mb-2">Quesadillas Herreñas</h3>
                      <p class="text-gray-600 text-sm mb-4">Elaboradas con queso fresco y horno de leña. Disponemos de marcas artesanas como Adrián.</p>
                      <a href="/contacto" class="text-green-700 font-bold text-sm hover:underline">Consultar Stock &rarr;</a>
                  </div>
              </div>

              <!-- Item 2 -->
              <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition group">
                  <div class="h-56 overflow-hidden relative">
                      <Image src={queso} alt="Queso Ahumado" class="w-full h-full object-cover group-hover:scale-110 transition duration-700"/>
                      <div class="absolute top-4 right-4 bg-orange-500 text-white text-xs font-bold px-3 py-1 rounded-full">Ahumado</div>
                  </div>
                  <div class="p-6">
                      <h3 class="font-bold text-xl mb-2">Queso de El Hierro</h3>
                      <p class="text-gray-600 text-sm mb-4">Tierno, semicurado y curado. Ahumado con leña de higuera y tunera. Un sabor único.</p>
                      <a href="/quesos-el-hierro-tenerife" class="text-green-700 font-bold text-sm hover:underline">Ver Variedades &rarr;</a>
                  </div>
              </div>

              <!-- Item 3 -->
              <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition group">
                  <div class="h-56 overflow-hidden relative bg-yellow-100 flex items-center justify-center">
                      <span class="text-8xl group-hover:scale-125 transition duration-500">🍍</span>
                      <div class="absolute top-4 right-4 bg-green-600 text-white text-xs font-bold px-3 py-1 rounded-full">Frescos</div>
                  </div>
                  <div class="p-6">
                      <h3 class="font-bold text-xl mb-2">Piña Tropical</h3>
                      <p class="text-gray-600 text-sm mb-4">Directa del Valle del Golfo. Roja Española, dulce y en su punto justo de maduración.</p>
                      <a href="/contacto" class="text-green-700 font-bold text-sm hover:underline">Ver Frutería &rarr;</a>
                  </div>
              </div>
          </div>
      </div>
  </section>

  <ContentWidget 
    title="Descubre El Hierro" 
    subtitle="Blog de Viajes y Gastronomía"
    collection="blog" 
    tags={['El Hierro', 'Turismo']}
    maxItems={3} 
    bgClass="bg-white"
  />

</Layout>