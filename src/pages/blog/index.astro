---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

// Fetch blog posts from content collection
const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = "Blog y Noticias - Terencio Cash Market";
const description = "Últimas noticias, novedades sobre productos, ofertas y actualidad de Terencio Cash Market en Tenerife.";
---

<Layout title={title} description={description}>
  <div class="bg-gray-100 py-12 text-center">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Blog y Noticias</h1>
      <p class="text-gray-600">Actualidad, consejos y novedades de tu supermercado en La Esperanza.</p>
    </div>
  </div>

  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-3 gap-8">
        {posts.map((post) => (
          <article class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition flex flex-col h-full border border-gray-100">
            <a href={`/blog/${post.slug}`}>
                <div class="h-48 bg-gray-200 w-full overflow-hidden">
                    <img 
                        src={post.data.image || '/logo.png'} 
                        alt={post.data.title}
                        class="w-full h-full object-cover transform hover:scale-105 transition duration-500"
                        onerror="this.src='/logo.png'"
                    />
                </div>
            </a>
            <div class="p-6 flex flex-col flex-grow">
              <div class="flex items-center gap-2 text-xs text-gray-500 mb-3">
                 <span>{post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                 <span>•</span>
                 <span>{post.data.author}</span>
              </div>
              <h2 class="text-xl font-bold text-gray-900 mb-3 leading-tight">
                <a href={`/blog/${post.slug}`} class="hover:text-green-700 transition">
                  {post.data.title}
                </a>
              </h2>
              <p class="text-gray-600 text-sm mb-4 flex-grow line-clamp-3">
                {post.data.description}
              </p>
              <a href={`/blog/${post.slug}`} class="text-green-700 font-bold text-sm uppercase tracking-wide hover:underline mt-auto">
                Leer más &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
      
      {posts.length === 0 && (
          <div class="text-center py-12">
              <p class="text-gray-500">No hay noticias publicadas todavía.</p>
          </div>
      )}
    </div>
  </section>
</Layout>
